#pragma once

#include <cstdint>
#include <string>

//
// Every key press on every keyboard is ultimately translated into one of
// these actions. The keyboard engine does NOT know about transpose, drums,
// loops, vocoder, etc. — it emits an Action; Engine / InstrumentState decide.
//
// Physical Layout V1 maps:
//   Bottom boards → Note (absolute cents from transposed root)
//   Top boards    → Mode / Mixer / Drum / Loop / system actions
//

enum class ActionType : uint8_t
{
    None = 0,

    //-----------------------
    // Musical notes
    //-----------------------
    Note,           // cents = absolute cents from root; semitone unused
    Drum,           // drum_note = GM-ish drum MIDI note

    //-----------------------
    // Global controls
    //-----------------------
    TransposeUp,
    TransposeDown,
    OctaveUp,       // manual octave nudge (nod still drives primary octave)
    OctaveDown,
    VolumeUp,       // master volume
    VolumeDown,
    Panic,          // all notes off

    //-----------------------
    // Performance modes (Physical Layout V1 row "Mode 1/2/3")
    //-----------------------
    ModeInstrument,     // Mode 1 — synth only
    ModeVocoder,        // Mode 2 — vocoder
    ModeVocoderDry,     // Mode 3 — vocoder + dry voice

    //-----------------------
    // Mixer (Physical Layout V1 mixer row)
    //-----------------------
    DryMixUp,
    DryMixDown,
    VocoderMixUp,
    VocoderMixDown,
    DrumMixUp,
    DrumMixDown,
    MasterVolUp,        // alias clarity for layout JSON
    MasterVolDown,

    //-----------------------
    // Looper (top board loop row) — Engine logs; real OSC/MIDI in Phase 4
    //-----------------------
    LoopRecord,
    LoopPlay,
    LoopStop,
    LoopOverdub,
    LoopUndo,
 LoopClear,
 LoopMute, // per-loop mute (Physical Layout V1 loop row)
 LoopMuteAll, // mutes all loops only -- never live Zyn
 //-----------------------
 // Effects
 //-----------------------
    ReverbToggle,
    DelayToggle,
    ChorusToggle,

    //-----------------------
    // Future expansion
    //-----------------------
    User1,
    User2,
    User3,
    User4
};

struct Action
{
    ActionType type = ActionType::None;

    // Note: absolute pitch in cents from the transposed root (Physical Layout V1).
    // Engine combines with octave*1200 + transpose*100, then splits into
    // MIDI note number + pitch-bend.
    int cents = 0;

    // Legacy / optional relative semitone (unused when cents is the source of truth).
    int semitone = 0;

    // Drum: MIDI note number on the drum channel (e.g. 36 = bass drum).
    int drum_note = 0;
 // Loop track index (0..3) for per-loop actions (LoopRecord/LoopMute/
 // LoopClear). Unused (0) for the shared-armed actions (LoopOverdub/
 // LoopUndo) and for LoopMuteAll.
 int loop_track = 0;
 // True on key press, false on key release.
    // Continuous controls (transpose, mix, mode) typically act on press only.
    bool pressed = true;
};

// String <-> enum for JSON layouts.
inline const char* actionTypeToString(ActionType t)
{
    switch (t)
    {
        case ActionType::None:           return "none";
        case ActionType::Note:           return "note";
        case ActionType::Drum:           return "drum";
        case ActionType::TransposeUp:    return "transpose_up";
        case ActionType::TransposeDown:  return "transpose_down";
        case ActionType::OctaveUp:       return "octave_up";
        case ActionType::OctaveDown:     return "octave_down";
        case ActionType::VolumeUp:       return "volume_up";
        case ActionType::VolumeDown:     return "volume_down";
        case ActionType::Panic:          return "panic";
        case ActionType::ModeInstrument: return "mode_instrument";
        case ActionType::ModeVocoder:    return "mode_vocoder";
        case ActionType::ModeVocoderDry: return "mode_vocoder_dry";
        case ActionType::DryMixUp:       return "dry_mix_up";
        case ActionType::DryMixDown:     return "dry_mix_down";
        case ActionType::VocoderMixUp:   return "vocoder_mix_up";
        case ActionType::VocoderMixDown: return "vocoder_mix_down";
        case ActionType::DrumMixUp:      return "drum_mix_up";
        case ActionType::DrumMixDown:    return "drum_mix_down";
        case ActionType::MasterVolUp:    return "master_vol_up";
        case ActionType::MasterVolDown:  return "master_vol_down";
        case ActionType::LoopRecord:     return "loop_record";
        case ActionType::LoopPlay:       return "loop_play";
        case ActionType::LoopStop:       return "loop_stop";
        case ActionType::LoopOverdub:    return "loop_overdub";
        case ActionType::LoopUndo:       return "loop_undo";
        case ActionType::LoopClear: return "loop_clear";
 case ActionType::LoopMute: return "loop_mute";
 case ActionType::LoopMuteAll: return "loop_mute_all";
        case ActionType::ReverbToggle:   return "reverb_toggle";
        case ActionType::DelayToggle:    return "delay_toggle";
        case ActionType::ChorusToggle:   return "chorus_toggle";
        case ActionType::User1:          return "user1";
        case ActionType::User2:          return "user2";
        case ActionType::User3:          return "user3";
        case ActionType::User4:          return "user4";
    }
    return "none";
}

inline ActionType stringToActionType(const std::string& s)
{
    if (s == "note")            return ActionType::Note;
    if (s == "drum")            return ActionType::Drum;
    if (s == "transpose_up")    return ActionType::TransposeUp;
    if (s == "transpose_down")  return ActionType::TransposeDown;
    if (s == "octave_up")       return ActionType::OctaveUp;
    if (s == "octave_down")     return ActionType::OctaveDown;
    if (s == "volume_up")       return ActionType::VolumeUp;
    if (s == "volume_down")     return ActionType::VolumeDown;
    if (s == "panic")           return ActionType::Panic;
    if (s == "mode_instrument") return ActionType::ModeInstrument;
    if (s == "mode_vocoder")    return ActionType::ModeVocoder;
    if (s == "mode_vocoder_dry")return ActionType::ModeVocoderDry;
    if (s == "dry_mix_up")      return ActionType::DryMixUp;
    if (s == "dry_mix_down")    return ActionType::DryMixDown;
    if (s == "vocoder_mix_up")  return ActionType::VocoderMixUp;
    if (s == "vocoder_mix_down")return ActionType::VocoderMixDown;
    if (s == "drum_mix_up")     return ActionType::DrumMixUp;
    if (s == "drum_mix_down")   return ActionType::DrumMixDown;
    if (s == "master_vol_up")   return ActionType::MasterVolUp;
    if (s == "master_vol_down") return ActionType::MasterVolDown;
    if (s == "loop_record")     return ActionType::LoopRecord;
    if (s == "loop_play")       return ActionType::LoopPlay;
    if (s == "loop_stop")       return ActionType::LoopStop;
    if (s == "loop_overdub")    return ActionType::LoopOverdub;
    if (s == "loop_undo")       return ActionType::LoopUndo;
    if (s == "loop_clear") return ActionType::LoopClear;
 if (s == "loop_mute") return ActionType::LoopMute;
 if (s == "loop_mute_all") return ActionType::LoopMuteAll;
    if (s == "reverb_toggle")   return ActionType::ReverbToggle;
    if (s == "delay_toggle")    return ActionType::DelayToggle;
    if (s == "chorus_toggle")   return ActionType::ChorusToggle;
    if (s == "user1")           return ActionType::User1;
    if (s == "user2")           return ActionType::User2;
    if (s == "user3")           return ActionType::User3;
    if (s == "user4")           return ActionType::User4;
    return ActionType::None;
}
