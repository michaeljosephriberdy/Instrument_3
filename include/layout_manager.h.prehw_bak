#pragma once

#include <array>
#include <string>
#include <vector>

#include "actions.h"
#include "keyboard_layout.h"  // ID75_ROWS, ID75_COLS, ID75_KEYS

//
// LayoutManager owns the four board layouts (JSON on disk → runtime Action grid).
// Physical Layout V1 is the default content of config/layouts/*.json.
//

class LayoutManager
{
public:
    // One complete 5×15 Action grid for a single physical keyboard.
    using BoardActions = std::array<Action, ID75_KEYS>;

    enum class BoardPosition
    {
        BottomRight = 0,
        TopRight    = 1,
        BottomLeft  = 2,
        TopLeft     = 3
    };

    struct KeyboardLayout
    {
        std::string name;
        bool inverted = false;
        BoardActions actions{};  // index = row * ID75_COLS + col
    };

    LayoutManager();

    // Load all four default layout files from a directory
    // (expects bottom_right.json, top_right.json, bottom_left.json, top_left.json).
    bool loadAll(const std::string& layouts_dir);

    bool loadLayout(const std::string& filename, KeyboardLayout& layout);
    bool saveLayout(const std::string& filename, const KeyboardLayout& layout) const;

    // Lookup after loadAll. Returns None-action if out of range / not loaded.
    Action actionFor(BoardPosition position, int row, int column) const;

    const KeyboardLayout& layout(BoardPosition position) const;

    // Physical column flip for boards mounted upside-down.
    static int convertColumn(int column, bool inverted);

    // Build the four Physical Layout V1 grids in memory (no disk). Useful as
    // fallback when JSON is missing, and as the seed that writes the JSON files.
    static void buildPhysicalLayoutV1(KeyboardLayout& bl,
                                      KeyboardLayout& br,
                                      KeyboardLayout& tl,
                                      KeyboardLayout& tr);

    static BoardPosition indexToPosition(int logical_index);
    static const char* positionToFileStem(BoardPosition p);
    // Build the built-in Physical Layout V1 grids (no JSON required).
    void buildDefaults();


private:
    static int index(int row, int col) { return row * ID75_COLS + col; }

    KeyboardLayout layouts_[4];
    bool loaded_ = false;
};
