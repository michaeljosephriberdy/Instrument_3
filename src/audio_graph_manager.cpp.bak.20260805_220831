{
    cfg_ = cfg;
}

bool AudioGraphManager::processAlive(pid_t pid) const
{
    if (pid <= 0)
        return false;
    return kill(pid, 0) == 0;
}

bool AudioGraphManager::zynRunning() const
{
    return processAlive(zyn_pid_);
}

bool AudioGraphManager::sooperlooperRunning() const
{
    return processAlive(sl_pid_);
}

bool AudioGraphManager::vocoderRunning() const
{
    return processAlive(voc_pid_);
}

void AudioGraphManager::killPid(pid_t& pid, const char* label)
{
    if (pid <= 0)
        return;

    if (kill(pid, 0) == 0)
    {
        Logger::info(std::string("Stopping ") + label +
                     " (pid " + std::to_string(pid) + ")");
        kill(pid, SIGTERM);
        // Brief wait, then escalate.
        for (int i = 0; i < 20; ++i)
        {
            if (waitpid(pid, nullptr, WNOHANG) > 0)
            {
                pid = -1;
                return;
            }
            std::this_thread::sleep_for(std::chrono::milliseconds(50));
        }
        kill(pid, SIGKILL);
        waitpid(pid, nullptr, 0);
    }
    pid = -1;
}

bool AudioGraphManager::pwLink(const std::string& src, const std::string& dst)
{
    if (src.empty() || dst.empty())
        return false;

    std::string cmd = "pw-link " + src + " " + dst + " 2>/dev/null";
    int rc = std::system(cmd.c_str());
    if (rc == 0)
    {
        owned_links_.push_back({src, dst});
        Logger::info("pw-link: " + src + " → " + dst);
        return true;
    }
    Logger::warning("pw-link failed: " + src + " → " + dst);
    return false;
}

bool AudioGraphManager::pwUnlink(const std::string& src, const std::string& dst)
{
    std::string cmd = "pw-link -d " + src + " " + dst + " 2>/dev/null";
    return std::system(cmd.c_str()) == 0;
}

void AudioGraphManager::disconnectAllOwnedLinks()
{
    for (auto it = owned_links_.rbegin(); it != owned_links_.rend(); ++it)
    {
        pwUnlink(it->first, it->second);
    }
    owned_links_.clear();
}

std::vector<std::string>
AudioGraphManager::findPorts(const std::string& substring, bool inputs) const
{
    std::vector<std::string> result;
    std::string flag = inputs ? "-i" : "-o";
    std::string cmd = "pw-link " + flag + " 2>/dev/null";
    std::string out = shellCapture(cmd);
    std::istringstream ss(out);
    std::string line;
    while (std::getline(ss, line))
    {
        while (!line.empty() && (line.back() == '\r' || line.back() == ' '))
            line.pop_back();
        if (line.find(substring) != std::string::npos)
            result.push_back(line);
    }
    return result;
}

bool AudioGraphManager::micPresent() const
{
    return queryMic().present;
}


bool AudioGraphManager::launchZyn()
{
    if (processAlive(zyn_pid_))
        return true;

    std::string bin = which(cfg_.zyn_binary.empty() ? "zynaddsubfx"
                                                    : cfg_.zyn_binary);
    if (bin.empty())
    {
        Logger::error("zynaddsubfx not found on PATH");
        return false;
    }

    pid_t pid = fork();
    if (pid < 0)
    {
        Logger::error("fork() failed for Zyn");
        return false;
    }

    if (pid == 0)
    {
        // Child: under PipeWire, pw-jack is optional but keeps JACK clients happy.
        std::string pwjack = which("pw-jack");
        if (!pwjack.empty())
        {
            execlp("pw-jack", "pw-jack",
                   bin.c_str(),
                   "-U",  // no GUI when possible
                   "-l", cfg_.zyn_instrument.c_str(),
            "-I", "jack",
            "-O", "jack",
            "-a",
            static_cast<char*>(nullptr));
        }
        execlp(bin.c_str(), bin.c_str(),
               "-U",
               "-l", cfg_.zyn_instrument.c_str(),
            "-I", "jack",
            "-O", "jack",
            "-a",
            static_cast<char*>(nullptr));
        _exit(127);
    }

    zyn_pid_ = pid;
    Logger::info("Launched Zyn pid=" + std::to_string(pid) +
                 " instrument=" + cfg_.zyn_instrument);

    // Give it a moment to register PipeWire ports.
    // Poll for Zyn's actual PipeWire ports instead of trusting a flat
    // delay -- launchSooperLooper()/launchVocoder() already do this;
    // launchZyn() didn't, which let buildMode1() race ahead of a
    // still-registering process on slower boots.
    bool zyn_ports_ready = false;
    for (int i = 0; i < 25; ++i) // up to ~5s @ 200ms
    {
        std::this_thread::sleep_for(std::chrono::milliseconds(200));
        auto outs = findPortsMatching({cfg_.zyn_client_name}, false);
        auto ins = findPortsMatching({cfg_.zyn_client_name}, true);
        if (!outs.empty() && !ins.empty())
        {
            zyn_ports_ready = true;
            break;
        }
    }
    if (!zyn_ports_ready)
    {
        Logger::warning("Zyn launched (pid=" + std::to_string(pid) +
            ") but its ports were not visible to PipeWire after ~5s -- "
            "links may fail");
    }
    return true;
}

bool AudioGraphManager::launchSooperLooper()
{
    if (processAlive(sl_pid_))
        return true;

    std::string bin = which(cfg_.sooperlooper_binary.empty()
                                ? "sooperlooper"
                                : cfg_.sooperlooper_binary);
    if (bin.empty())
    {
        Logger::warning("sooperlooper not found — install package 'sooperlooper'; "
                        "loop keys will log only");
        return false;
    }

    pid_t pid = fork();
    if (pid < 0)
    {
        Logger::error("fork() failed for SooperLooper");
        return false;
    }

    if (pid == 0)
    {
        // Headless: -p OSC port, -l 4 four independent loops, -c 2 stereo channels.
        // Do not pass -j (JACK name) in a way that breaks PipeWire.
        std::string port = std::to_string(cfg_.sooperlooper_osc_port);
        std::string pwjack = which("pw-jack");
        if (!pwjack.empty())
        {
            execlp("pw-jack", "pw-jack",
                   bin.c_str(),
                   "-p", port.c_str(),
 "-l", "4",
 "-c", "2",
 static_cast<char*>(nullptr));
 }
 execlp(bin.c_str(), bin.c_str(),
 "-p", port.c_str(),
 "-l", "4",
 "-c", "2",
 static_cast<char*>(nullptr));
        _exit(127);
    }

    sl_pid_ = pid;
    Logger::info("Launched SooperLooper pid=" + std::to_string(pid) +
                 " OSC :" + std::to_string(cfg_.sooperlooper_osc_port));

    // Wait for PipeWire ports to appear.
    for (int i = 0; i < 15; ++i)
    {
        std::this_thread::sleep_for(std::chrono::milliseconds(200));
        auto outs = findPortsMatching({"sooperlooper", "SooperLooper", "common_out"}, false);
        if (!outs.empty())
            break;
    }
    return true;
}


bool AudioGraphManager::launchVocoder()
{
    if (processAlive(voc_pid_))
        return true;

    // Prefer headless jalv; fall back to jalv.gtk.
    std::string jalv = which(cfg_.jalv_binary.empty() ? "jalv" : cfg_.jalv_binary);
    if (jalv.empty())
        jalv = which("jalv.gtk");
    if (jalv.empty())
        jalv = which("jalv.gtk3");
    if (jalv.empty())
    {
        Logger::warning("jalv not found — install 'jalv' and 'calf-plugins' for Mode 2/3");
        return false;
    }

    // Verify the LV2 URI is installed (lv2ls).
    std::string lv2ls = which("lv2ls");
    if (!lv2ls.empty())
    {
        std::string listed = shellCapture(lv2ls + " 2>/dev/null");
        if (listed.find("Vocoder") == std::string::npos &&
            listed.find(cfg_.calf_vocoder_uri) == std::string::npos)
        {
            Logger::warning("Calf Vocoder LV2 URI not found in lv2ls — "
                            "is calf-plugins installed?");
            // Still try; some systems omit URI strings from lv2ls output format.
        }
    }

    pid_t pid = fork();
    if (pid < 0)
    {
        Logger::error("fork() failed for vocoder host");
        return false;
    }

    if (pid == 0)
    {
        // -n sets JACK/PipeWire node name prefix when supported.
        std::string pwjack = which("pw-jack");
        if (!pwjack.empty())
        {
            execlp("pw-jack", "pw-jack",
                   jalv.c_str(),
                   "-n", "InstrumentVocoder",
                   cfg_.calf_vocoder_uri.c_str(),
                   static_cast<char*>(nullptr));
        }
        execlp(jalv.c_str(), jalv.c_str(),
               "-n", "InstrumentVocoder",
               cfg_.calf_vocoder_uri.c_str(),
               static_cast<char*>(nullptr));
        _exit(127);
    }

    voc_pid_ = pid;
    Logger::info("Launched Calf Vocoder host pid=" + std::to_string(pid) +
                 " node=InstrumentVocoder");

    for (int i = 0; i < 20; ++i)
    {
        std::this_thread::sleep_for(std::chrono::milliseconds(200));
        auto outs = findPortsMatching(
            {"InstrumentVocoder", "Vocoder", "calf"}, false);
        if (!outs.empty())
            break;
    }
    return true;
}



bool AudioGraphManager::startProcesses()
{
    bool ok = launchZyn();
    // Non-fatal: looper and vocoder can appear later.
    launchSooperLooper();
    // Vocoder process is only required for Mode 2/3; start lazily in setMode
    // to avoid pulling in jalv/GUI noise on Mode 1 boots.
    started_ = ok;
    return ok;
}

void AudioGraphManager::stopProcesses()
{
    disconnectAllOwnedLinks();
    killPid(voc_pid_, "vocoder");
    killPid(sl_pid_, "sooperlooper");
    killPid(zyn_pid_, "zynaddsubfx");
    started_ = false;
}

bool AudioGraphManager::buildMode1()
{
    disconnectAllOwnedLinks();

    if (!processAlive(zyn_pid_))
    {
        if (!launchZyn())
            return false;
    }

    // Zyn stereo → default playback (non-HDMI).
    std::string zyn_l = cfg_.zyn_client_name + ":out_1";
    std::string zyn_r = cfg_.zyn_client_name + ":out_2";
    std::string play_l = defaultPlaybackPort(true);
    std::string play_r = defaultPlaybackPort(false);

    if (play_l.empty() || play_r.empty())
    {
        Logger::warning("Could not find default playback ports; "
                        "trying common PipeWire patterns");
        play_l = "alsa_output.pci-0000_00_1f.3.analog-stereo:playback_FL";
        play_r = "alsa_output.pci-0000_00_1f.3.analog-stereo:playback_FR";
    }

    pwLink(zyn_l, play_l);
    pwLink(zyn_r, play_r);

    // Engine MIDI → Zyn
    pwLink(cfg_.engine_midi_name, cfg_.zyn_client_name + ":midi_input");

    Logger::info("Graph: Mode 1 (SynthOnly) built");
    applyMixerLevels(last_master_, last_dry_, last_vocoder_, last_drums_);
    return true;
}

bool AudioGraphManager::buildMode2()
{
    disconnectAllOwnedLinks();

    if (!processAlive(zyn_pid_) && !launchZyn())
        return false;

    MicInfo mic = queryMic();
    if (!mic.present)
    {
        Logger::warning("Mode 2: mic (" + cfg_.mic_name_hint +
                        ") not present — falling back to Mode 1");
        return buildMode1();
    }

    Logger::info("Mode 2: mic ALSA=" +
                 (mic.alsa_hint.empty() ? mic.alsa_card_name : mic.alsa_hint) +
                 " capture_ports=" + std::to_string(mic.capture_ports.size()));
    for (const auto& p : mic.capture_ports)
        Logger::info("  mic port: " + p);

    // Start vocoder host if needed.
    if (!processAlive(voc_pid_))
        launchVocoder();

    std::string zyn_l = cfg_.zyn_client_name + ":out_1";
    std::string zyn_r = cfg_.zyn_client_name + ":out_2";
    std::string play_l = defaultPlaybackPort(true);
    std::string play_r = defaultPlaybackPort(false);

    // Discover vocoder ports (jalv + Calf naming varies by host version).
    std::vector<std::string> voc_needles = {
        "InstrumentVocoder", "Vocoder", "calf", "vocoder", "jalv"
    };
    auto voc_in  = findPortsMatching(voc_needles, true);
    auto voc_out = findPortsMatching(voc_needles, false);

    // Filter out our own unrelated jalv instances if possible: prefer "Vocoder".
    auto prefer_vocoder = [](std::vector<std::string> ports) {
        std::vector<std::string> ranked;
        for (const auto& p : ports)
        {
            std::string low = p;
            for (char& c : low)
                c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
            if (low.find("vocoder") != std::string::npos)
                ranked.insert(ranked.begin(), p);
            else
                ranked.push_back(p);
        }
        return ranked;
    };
    voc_in  = prefer_vocoder(voc_in);
    voc_out = prefer_vocoder(voc_out);

    Logger::info("Mode 2: vocoder in=" + std::to_string(voc_in.size()) +
                 " out=" + std::to_string(voc_out.size()));
    for (const auto& p : voc_in)
        Logger::info("  voc in:  " + p);
    for (const auto& p : voc_out)
        Logger::info("  voc out: " + p);

    bool linked_vocoder = false;

    if (processAlive(voc_pid_) && !voc_in.empty() && !voc_out.empty())
    {
        // Carrier: Zyn L → first vocoder audio input (typical: In L / carrier).
        // Modulator: mic → second input if present, else same input.
        pwLink(zyn_l, voc_in[0]);
        if (voc_in.size() > 1)
            pwLink(zyn_r, voc_in[1]);

        if (!mic.capture_ports.empty())
        {
            // Modulator into next free input or input 0 if only one.
            size_t mod_idx = voc_in.size() > 2 ? 2 : 0;
            if (voc_in.size() > 1 && mod_idx == 0)
                mod_idx = 1; // common stereo in: L=carrier-ish, R=modulator-ish
            pwLink(mic.capture_ports[0], voc_in[mod_idx]);
        }

        if (!play_l.empty())
            pwLink(voc_out[0], play_l);
        if (voc_out.size() > 1 && !play_r.empty())
            pwLink(voc_out[1], play_r);
        else if (!play_r.empty() && !voc_out.empty())
            pwLink(voc_out[0], play_r);

        linked_vocoder = true;
        Logger::info("Graph: Mode 2 (VocoderOnly) - Zyn+mic -> vocoder -> playback");
    applyMixerLevels(last_master_, last_dry_, last_vocoder_, last_drums_);
    applyMixerLevels(last_master_, last_dry_, last_vocoder_, last_drums_);
    }
    else
    {
        // Degraded Mode 2: Zyn → playback, mic logged but not in path.
        Logger::warning("Mode 2: vocoder ports unavailable — Zyn direct + mic side-chain later");
        if (!play_l.empty())
            pwLink(zyn_l, play_l);
        if (!play_r.empty())
            pwLink(zyn_r, play_r);
    }

    pwLink(cfg_.engine_midi_name, cfg_.zyn_client_name + ":midi_input");

    if (!linked_vocoder)
        Logger::info("Graph: Mode 2 degraded (no Calf graph yet)");

    return true;
}


bool AudioGraphManager::buildMode3()
{
    // Mode 3 = Mode 2 vocoder path + dry mic to playback.
    disconnectAllOwnedLinks();

    if (!processAlive(zyn_pid_) && !launchZyn())
        return false;

    MicInfo mic = queryMic();

    // Build the vocoder path by reusing Mode 2 logic carefully:
    // call internal sequence without double disconnect — we already cleared.
    // Simpler: run Mode 2 builder (it disconnects again — OK) then add dry.
    if (!buildMode2())
        return false;

    if (!mic.present || mic.capture_ports.empty())
    {
        Logger::warning("Mode 3: no mic capture port for dry path");
        Logger::info("Graph: Mode 3 without dry mic");
        return true;
    }

    std::string play_l = defaultPlaybackPort(true);
    std::string play_r = defaultPlaybackPort(false);

    // Dry mic → playback (parallel to vocoder). Level control is Phase 4.4.
    if (!play_l.empty())
        pwLink(mic.capture_ports[0], play_l);
    if (mic.capture_ports.size() > 1 && !play_r.empty())
        pwLink(mic.capture_ports[1], play_r);
    else if (!play_r.empty())
        pwLink(mic.capture_ports[0], play_r);

    Logger::info("Graph: Mode 3 (SynthAndVocoder) — vocoder + dry mic");
    return true;
}


bool AudioGraphManager::setMode(PerformanceMode mode)
{
    mode_ = mode;
    switch (mode)
    {
        case PerformanceMode::SynthOnly:
            return buildMode1();
        case PerformanceMode::VocoderOnly:
            return buildMode2();
        case PerformanceMode::SynthAndVocoder:
            return buildMode3();
    }
    return buildMode1();
}



std::string AudioGraphManager::statusSummary() const
{
    std::ostringstream ss;
    ss << "mode=";
    switch (mode_)
    {
        case PerformanceMode::SynthOnly:      ss << "SynthOnly"; break;
        case PerformanceMode::VocoderOnly:    ss << "VocoderOnly"; break;
        case PerformanceMode::SynthAndVocoder: ss << "SynthAndVocoder"; break;
    }
    ss << " zyn=" << (zynRunning() ? "up" : "down")
       << " sl=" << (sooperlooperRunning() ? "up" : "down")
       << " voc=" << (vocoderRunning() ? "up" : "down")
       << " mic=" << (micPresent() ? "yes" : "no")
       << " links=" << owned_links_.size();
    return ss.str();
}

// --- Looper OSC ---------------------------------------------------------
// SooperLooper runs with 4 independent loops (-l 4). Per-loop control
// uses /sl/<track>/hit (track 0..3); the "armed" loop (default 0,
// re-armed by Record on that track) is the target for the shared
// Overdub/Undo controls. Mute All addresses SooperLooper's broadcast
// loop index (-1) so it only silences the loops -- never live Zyn.
// Prefer `oscsend` if present; otherwise log (see sendLooperOsc()).
namespace
{
 std::string loopHitPath(int track)
 {
     return "/sl/" + std::to_string(track) + "/hit";
 }
}
void AudioGraphManager::looperRecordTrack(int track)
{
    if (track < 0 || track > 3)
        return;
    if (!processAlive(sl_pid_))
    {
        if (!launchSooperLooper())
        {
            Logger::info("Looper Record track " + std::to_string(track) +
                         " (SooperLooper unavailable)");
            return;
        }
        connectLooperGraph();
    }
    armed_loop_ = track; // Record arms this track for shared Overdub/Undo.
    sendLooperOsc(loopHitPath(track), "s", "record");
}
void AudioGraphManager::looperMuteTrack(int track)
{
    if (track < 0 || track > 3)
        return;
    if (!processAlive(sl_pid_))
    {
        Logger::info("Looper Mute track " + std::to_string(track) +
                     " (SooperLooper not running)");
        return;
    }
    sendLooperOsc(loopHitPath(track), "s", "mute");
}
void AudioGraphManager::looperClearTrack(int track)
{
    if (track < 0 || track > 3)
        return;
    if (!processAlive(sl_pid_))
    {
        Logger::info("Looper Clear track " + std::to_string(track) +
                     " (SooperLooper not running)");
        return;
    }
    // undo_all clears the loop content on common setups.
    sendLooperOsc(loopHitPath(track), "s", "undo_all");
}
void AudioGraphManager::looperMuteAll()
{
    if (!processAlive(sl_pid_))
    {
        Logger::info("Looper Mute All (SooperLooper not running)");
        return;
    }
    // Loop index -1 is SooperLooper's broadcast address -- every loop,
    // and only the loops (live Zyn output is a separate, unaffected
    // graph path).
    sendLooperOsc("/sl/-1/hit", "s", "mute");
}
void AudioGraphManager::looperRecord() { looperRecordTrack(0); }
void AudioGraphManager::looperClear() { looperClearTrack(0); }
void AudioGraphManager::looperOverdub()
{
    if (!processAlive(sl_pid_))
    {
        Logger::info("Looper Overdub (SooperLooper not running)");
        return;
    }
    sendLooperOsc(loopHitPath(armed_loop_), "s", "overdub");
}
void AudioGraphManager::looperPlay()
{
    if (!processAlive(sl_pid_))
    {
        Logger::info("Looper Play (SooperLooper not running)");
        return;
    }
    // 'trigger' starts playback from the beginning; 'pause' toggles.
    sendLooperOsc(loopHitPath(armed_loop_), "s", "trigger");
}
void AudioGraphManager::looperStop()
{
    if (!processAlive(sl_pid_))
    {
        Logger::info("Looper Stop (SooperLooper not running)");
        return;
    }
    // Pause if playing; mute as a hard silence fallback.
    sendLooperOsc(loopHitPath(armed_loop_), "s", "pause");
}
void AudioGraphManager::looperUndo()
{
    if (!processAlive(sl_pid_))
    {
        Logger::info("Looper Undo (SooperLooper not running)");
        return;
    }
    sendLooperOsc(loopHitPath(armed_loop_), "s", "undo");
}


// =============================================================================
// Phase 4.2 — mic discovery + Mode 2/3 link map
// =============================================================================

std::vector<std::string>
AudioGraphManager::findPortsMatching(
    const std::vector<std::string>& needles,
    bool inputs) const
{
    std::vector<std::string> result;
    std::string flag = inputs ? "-i" : "-o";
    std::string out = shellCapture("pw-link " + flag + " 2>/dev/null");
    std::istringstream ss(out);
    std::string line;
    while (std::getline(ss, line))
    {
        while (!line.empty() &&
               (line.back() == '\r' || line.back() == ' ' || line.back() == '\n'))
            line.pop_back();
        if (line.empty())
            continue;
        std::string lower = line;
        for (char& c : lower)
            c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
        for (const auto& n : needles)
        {
            std::string nl = n;
            for (char& c : nl)
                c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
            if (lower.find(nl) != std::string::npos)
            {
                result.push_back(line);
                break;
            }
        }
    }
    return result;
}

AudioGraphManager::MicInfo AudioGraphManager::queryMic() const
{
    MicInfo info;

    // 1) ALSA card list — authoritative for "is the Shure plugged in?"
    std::string cards = shellCapture("arecord -l 2>/dev/null");
    if (cards.find(cfg_.mic_name_hint) != std::string::npos)
    {
        info.present = true;
        info.alsa_card_name = cfg_.mic_name_hint;

        // Try to extract "card N: MVX2U"
        std::istringstream css(cards);
        std::string line;
        while (std::getline(css, line))
        {
            if (line.find(cfg_.mic_name_hint) == std::string::npos)
                continue;
            // "card 3: MVX2U [Shure MVX2U], device 0: ..."
            auto pos = line.find("card ");
            if (pos != std::string::npos)
            {
                int card = -1;
                if (std::sscanf(line.c_str() + pos, "card %d:", &card) == 1 && card >= 0)
                    info.alsa_hint = "hw:" + std::to_string(card) + ",0";
            }
            break;
        }
    }

    // 2) PipeWire capture ports — what we actually link.
    //    Match MVX2U, Shure, and common USB-audio patterns.
    std::vector<std::string> needles = {
        cfg_.mic_name_hint,
        "Shure",
        "MVX2U",
        "USB Audio",
    };
    info.capture_ports = findPortsMatching(needles, true);

    // Prefer ports that look like mono/capture_MONO or capture_FL over monitors.
    std::vector<std::string> preferred;
    std::vector<std::string> rest;
    for (const auto& p : info.capture_ports)
    {
        std::string low = p;
        for (char& c : low)
            c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
        if (low.find("monitor") != std::string::npos)
            info.monitor_ports.push_back(p);
        else if (low.find("capture") != std::string::npos ||
                 low.find("input") != std::string::npos ||
                 low.find("mono") != std::string::npos ||
                 low.find("_fl") != std::string::npos ||
                 low.find("_fr") != std::string::npos ||
                 low.find("aux0") != std::string::npos)
            preferred.push_back(p);
        else
            rest.push_back(p);
    }
    info.capture_ports.clear();
    info.capture_ports.insert(info.capture_ports.end(), preferred.begin(), preferred.end());
    info.capture_ports.insert(info.capture_ports.end(), rest.begin(), rest.end());

    if (!info.capture_ports.empty())
        info.present = true;

    return info;
}

