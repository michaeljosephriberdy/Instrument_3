bool AudioGraphManager::sendLooperOsc(const std::string& path,
                                      const std::string& type_tags,
                                      const std::string& arg) const
{
    // liblo-tools: oscsend host port /path types args...
    // Example: oscsend localhost 9951 /sl/0/hit s record
    std::string oscsend_bin = which("oscsend");
    if (oscsend_bin.empty())
    {
        Logger::warning("oscsend not found — install liblo-tools for looper control");
        return false;
    }

    std::ostringstream cmd;
    cmd << oscsend_bin << " localhost " << cfg_.sooperlooper_osc_port
        << " " << path;
    if (!type_tags.empty())
        cmd << " " << type_tags;
    if (!arg.empty())
        cmd << " " << arg;
    cmd << " 2>/dev/null";

    int rc = std::system(cmd.str().c_str());
    if (rc != 0)
    {
        Logger::warning("oscsend failed: " + path + " " + type_tags + " " + arg);
        return false;
    }
    Logger::info("Looper OSC: " + path + " " + type_tags + " " + arg);
    return true;
}

void AudioGraphManager::connectLooperGraph()
{
    if (!processAlive(sl_pid_))
        return;
    // With -l 4, SooperLooper still exposes one common stereo in/out bus
    // that sums all 4 loops -- per-loop OSC control does not require
    // per-loop PipeWire ports, so the link topology below is unchanged.
    // Discover SL ports. Names vary slightly by version / pw-jack.
    auto sl_in  = findPortsMatching(
        {"sooperlooper", "SooperLooper", "common_in", "loop0_in"}, true);
    auto sl_out = findPortsMatching(
        {"sooperlooper", "SooperLooper", "common_out", "loop0_out"}, false);

    if (sl_in.empty() || sl_out.empty())
    {
        Logger::warning("SooperLooper ports not visible yet — skip looper graph links");
        return;
    }

    Logger::info("SooperLooper ports in=" + std::to_string(sl_in.size()) +
                 " out=" + std::to_string(sl_out.size()));
    for (const auto& p : sl_in)
        Logger::info("  SL in:  " + p);
    for (const auto& p : sl_out)
        Logger::info("  SL out: " + p);

    std::string zyn_l = cfg_.zyn_client_name + ":out_1";
    std::string zyn_r = cfg_.zyn_client_name + ":out_2";
    std::string play_l = defaultPlaybackPort(true);
    std::string play_r = defaultPlaybackPort(false);

    // Feed SL from Zyn (parallel to main synth path).
    if (!sl_in.empty())
        pwLink(zyn_l, sl_in[0]);
    if (sl_in.size() > 1)
        pwLink(zyn_r, sl_in[1]);

    // SL output → playback (wet parallel).
    if (!sl_out.empty() && !play_l.empty())
        pwLink(sl_out[0], play_l);
    if (sl_out.size() > 1 && !play_r.empty())
        pwLink(sl_out[1], play_r);
    else if (!sl_out.empty() && !play_r.empty())
        pwLink(sl_out[0], play_r);

    Logger::info("Looper graph linked (Zyn → SL → playback)");
}


bool AudioGraphManager::setNodeVolume(const std::string& node_name_substring,
                                      float linear)
{
    if (linear < 0.f) linear = 0.f;
    if (linear > 1.f) linear = 1.f;

    std::string pactl = which("pactl");
    if (!pactl.empty())
    {
        std::string sinks = shellCapture(pactl + " list short sinks 2>/dev/null");
        std::istringstream ss(sinks);
        std::string line;
        while (std::getline(ss, line))
        {
            if (line.find(node_name_substring) == std::string::npos)
                continue;
            std::istringstream ls(line);
            std::string id, name;
            ls >> id >> name;
            int percent = static_cast<int>(linear * 100.0f + 0.5f);
            std::string setcmd = pactl + " set-sink-volume " + id + " " +
                                 std::to_string(percent) + "% 2>/dev/null";
            if (std::system(setcmd.c_str()) == 0)
            {
                Logger::info("Volume " + name + " -> " + std::to_string(percent) + "%");
                return true;
            }
        }
    }

    Logger::debug("setNodeVolume '" + node_name_substring + "' linear=" +
                  std::to_string(linear) + " (no matching sink; recorded only)");
    return false;
}

void AudioGraphManager::applyMixerLevels(int master, int dry, int vocoder, int drums)
{
    last_master_  = master;
    last_dry_     = dry;
    last_vocoder_ = vocoder;
    last_drums_   = drums;

    float m = master / 127.0f;
    float d = dry / 127.0f;
    float v = vocoder / 127.0f;
    // Dry/voice node gain is a fraction of the master ceiling.
    float dry_final = d * m;
    // Vocoder gain is a fraction of the dry/voice level (relative to
    // voice), not an independent absolute -- it rides on dry_final.
    float vocoder_final = v * dry_final;

    Logger::info(
        "Mixer apply master=" + std::to_string(master) +
        " dry=" + std::to_string(dry) +
        " vocoder=" + std::to_string(vocoder) +
        " drums=" + std::to_string(drums));

    std::string wpctl = which("wpctl");
    if (!wpctl.empty())
    {
        std::ostringstream cmd;
        cmd << wpctl << " set-volume @DEFAULT_AUDIO_SINK@ " << m << " 2>/dev/null";
        if (std::system(cmd.str().c_str()) == 0)
            Logger::info("Master -> DEFAULT_AUDIO_SINK " + std::to_string(m));
    }
    else
    {
        setNodeVolume("analog-stereo", m);
    }

    setNodeVolume("InstrumentVocoder", vocoder_final);
    if (!cfg_.mic_name_hint.empty())
        setNodeVolume(cfg_.mic_name_hint, dry_final);
    // NOTE: 'drums' is intentionally not applied to any PipeWire node
    // here -- drum loudness is a MIDI-velocity path, not an audio-graph
    // gain: Engine::handleAction's ActionType::Drum case scales note-on
    // velocity by (drumMix/127) * (masterVolume/127) directly. Breath
    // and vocoder gain never touch that path.
}

