std::vector<std::string>
AudioGraphManager::findPortsMatching(
    const std::vector<std::string>& needles,
    bool inputs) const
{
    std::vector<std::string> result;
    std::string flag = inputs ? "-i" : "-o";
    std::string out = shellCapture("pw-link " + flag + " 2>/dev/null");
    std::istringstream ss(out);
    std::string line;
    while (std::getline(ss, line))
    {
        while (!line.empty() &&
               (line.back() == '\r' || line.back() == ' ' || line.back() == '\n'))
            line.pop_back();
        if (line.empty())
            continue;
        std::string lower = line;
        for (char& c : lower)
            c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
        for (const auto& n : needles)
        {
            std::string nl = n;
            for (char& c : nl)
                c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
            if (lower.find(nl) != std::string::npos)
            {
                result.push_back(line);
                break;
            }
        }
    }
    return result;
}

AudioGraphManager::MicInfo AudioGraphManager::queryMic() const
{
    MicInfo info;

    // 1) ALSA card list — authoritative for "is the Shure plugged in?"
    std::string cards = shellCapture("arecord -l 2>/dev/null");
    if (cards.find(cfg_.mic_name_hint) != std::string::npos)
    {
        info.present = true;
        info.alsa_card_name = cfg_.mic_name_hint;

        // Try to extract "card N: MVX2U"
        std::istringstream css(cards);
        std::string line;
        while (std::getline(css, line))
        {
            if (line.find(cfg_.mic_name_hint) == std::string::npos)
                continue;
            // "card 3: MVX2U [Shure MVX2U], device 0: ..."
            auto pos = line.find("card ");
            if (pos != std::string::npos)
            {
                int card = -1;
                if (std::sscanf(line.c_str() + pos, "card %d:", &card) == 1 && card >= 0)
                    info.alsa_hint = "hw:" + std::to_string(card) + ",0";
            }
            break;
        }
    }

    // 2) PipeWire capture ports — what we actually link.
    //    Match MVX2U, Shure, and common USB-audio patterns.
    std::vector<std::string> needles = {
        cfg_.mic_name_hint,
        "Shure",
        "MVX2U",
        "USB Audio",
    };
    info.capture_ports = findPortsMatching(needles, true);

    // Prefer ports that look like mono/capture_MONO or capture_FL over monitors.
    std::vector<std::string> preferred;
    std::vector<std::string> rest;
    for (const auto& p : info.capture_ports)
    {
        std::string low = p;
        for (char& c : low)
            c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
        if (low.find("monitor") != std::string::npos)
            info.monitor_ports.push_back(p);
        else if (low.find("capture") != std::string::npos ||
                 low.find("input") != std::string::npos ||
                 low.find("mono") != std::string::npos ||
                 low.find("_fl") != std::string::npos ||
                 low.find("_fr") != std::string::npos ||
                 low.find("aux0") != std::string::npos)
            preferred.push_back(p);
        else
            rest.push_back(p);
    }
    info.capture_ports.clear();
    info.capture_ports.insert(info.capture_ports.end(), preferred.begin(), preferred.end());
    info.capture_ports.insert(info.capture_ports.end(), rest.begin(), rest.end());

    if (!info.capture_ports.empty())
        info.present = true;

    return info;
}

