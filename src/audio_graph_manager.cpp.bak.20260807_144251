namespace
{
    std::string which(const std::string& name)
    {
        if (name.empty())
            return {};
        // Absolute path?
        if (name.front() == '/')
            return name;

        std::string cmd = "command -v " + name + " 2>/dev/null";
        FILE* f = popen(cmd.c_str(), "r");
        if (!f)
            return {};
        char buf[512];
        std::string out;
        if (fgets(buf, sizeof(buf), f))
        {
            out = buf;
            while (!out.empty() && (out.back() == '\n' || out.back() == '\r'))
                out.pop_back();
        }
        pclose(f);
        return out;
    }

    std::string shellCapture(const std::string& cmd)
    {
        FILE* f = popen(cmd.c_str(), "r");
        if (!f)
            return {};
        std::string out;
        char buf[1024];
        while (fgets(buf, sizeof(buf), f))
            out += buf;
        pclose(f);
        return out;
    }

    // First non-HDMI playback sink port matching left/right preference.
    std::string defaultPlaybackPort(bool left)
    {
        // Prefer PipeWire port list; fall back to a common pattern.
        std::string needle = left ? "playback_FL" : "playback_FR";
        std::string cmd =
            "pw-link -i 2>/dev/null | grep -i '" + needle +
            "' | grep -vi hdmi | head -n 1";
        std::string line = shellCapture(cmd);
        while (!line.empty() && (line.back() == '\n' || line.back() == '\r' ||
                                 line.back() == ' '))
            line.pop_back();
        return line;
    }
}

