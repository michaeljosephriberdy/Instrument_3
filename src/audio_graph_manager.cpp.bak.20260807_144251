bool AudioGraphManager::launchZyn()
{
    if (processAlive(zyn_pid_))
        return true;
    // Runtime identity of the melodic instance.
    if (cfg_.zyn_client_name.empty() || cfg_.zyn_client_name == "zynaddsubfx")
        cfg_.zyn_client_name = "zyn-melody";

    std::string bin = which(cfg_.zyn_binary.empty() ? "zynaddsubfx" : cfg_.zyn_binary);
    if (bin.empty()) {
        Logger::error("zynaddsubfx not found");
        return false;
    }
    pid_t pid = fork();
    if (pid < 0)
        return false;
    if (pid == 0) {
        std::string pwjack = which("pw-jack");
        const char* name = cfg_.zyn_client_name.c_str();
        if (!pwjack.empty())
            execlp("pw-jack", "pw-jack", bin.c_str(),
                   "-U", "-N", name, "-l", cfg_.zyn_instrument.c_str(),
                   "-I", "jack", "-O", "jack", "-a",
                   static_cast<char*>(nullptr));
        execlp(bin.c_str(), bin.c_str(),
               "-U", "-N", name, "-l", cfg_.zyn_instrument.c_str(),
               "-I", "jack", "-O", "jack", "-a",
               static_cast<char*>(nullptr));
        _exit(127);
    }
    zyn_pid_ = pid;
    Logger::info("Launched MELODY Zyn pid=" + std::to_string(pid) +
                 " client='" + cfg_.zyn_client_name +
                 "' file=" + cfg_.zyn_instrument);
    for (int i = 0; i < 30; ++i) {
        std::this_thread::sleep_for(std::chrono::milliseconds(200));
        if (!findPortsMatching({cfg_.zyn_client_name}, false).empty()) {
            Logger::info("Melody Zyn ports visible");
            break;
        }
    }
    return true;
}


bool AudioGraphManager::launchZynDrums()
{
    if (processAlive(zyn_drums_pid_))
        return true;
    if (cfg_.zyn_drums_client_name.empty())
        cfg_.zyn_drums_client_name = "zyn-drums";
    if (cfg_.zyn_drums_instrument.empty())
        cfg_.zyn_drums_instrument = "config/drums.xmz";

    std::string bin = which(cfg_.zyn_binary.empty() ? "zynaddsubfx" : cfg_.zyn_binary);
    if (bin.empty())
        return false;
    {
        std::ifstream f(cfg_.zyn_drums_instrument);
        if (!f.good()) {
            Logger::warning("drums file missing: " + cfg_.zyn_drums_instrument);
            return false;
        }
    }
    pid_t pid = fork();
    if (pid < 0)
        return false;
    if (pid == 0) {
        std::string pwjack = which("pw-jack");
        const char* name = cfg_.zyn_drums_client_name.c_str();
        if (!pwjack.empty())
            execlp("pw-jack", "pw-jack", bin.c_str(),
                   "-U", "-N", name, "-l", cfg_.zyn_drums_instrument.c_str(),
                   "-I", "jack", "-O", "jack", "-a",
                   static_cast<char*>(nullptr));
        execlp(bin.c_str(), bin.c_str(),
               "-U", "-N", name, "-l", cfg_.zyn_drums_instrument.c_str(),
               "-I", "jack", "-O", "jack", "-a",
               static_cast<char*>(nullptr));
        _exit(127);
    }
    zyn_drums_pid_ = pid;
    Logger::info("Launched DRUMS Zyn pid=" + std::to_string(pid) +
                 " client='" + cfg_.zyn_drums_client_name +
                 "' file=" + cfg_.zyn_drums_instrument);
    for (int i = 0; i < 30; ++i) {
        std::this_thread::sleep_for(std::chrono::milliseconds(200));
        if (!findPortsMatching({cfg_.zyn_drums_client_name}, false).empty()) {
            Logger::info("Drums Zyn ports visible");
            break;
        }
    }
    return true;
}





bool AudioGraphManager::launchSooperLooper()
{
    if (processAlive(sl_pid_))
        return true;

    std::string bin = which(cfg_.sooperlooper_binary.empty()
                                ? "sooperlooper"
                                : cfg_.sooperlooper_binary);
    if (bin.empty())
    {
        Logger::warning("sooperlooper not found — install package 'sooperlooper'; "
                        "loop keys will log only");
        return false;
    }

    pid_t pid = fork();
    if (pid < 0)
    {
        Logger::error("fork() failed for SooperLooper");
        return false;
    }

    if (pid == 0)
    {
        // Headless: -p OSC port, -l 4 four independent loops, -c 2 stereo channels.
        // Do not pass -j (JACK name) in a way that breaks PipeWire.
        std::string port = std::to_string(cfg_.sooperlooper_osc_port);
        std::string pwjack = which("pw-jack");
        if (!pwjack.empty())
        {
            execlp("pw-jack", "pw-jack",
                   bin.c_str(),
                   "-p", port.c_str(),
 "-l", "4",
 "-c", "2",
 static_cast<char*>(nullptr));
 }
 execlp(bin.c_str(), bin.c_str(),
 "-p", port.c_str(),
 "-l", "4",
 "-c", "2",
 static_cast<char*>(nullptr));
        _exit(127);
    }

    sl_pid_ = pid;
    Logger::info("Launched SooperLooper pid=" + std::to_string(pid) +
                 " OSC :" + std::to_string(cfg_.sooperlooper_osc_port));

    // Wait for PipeWire ports to appear.
    for (int i = 0; i < 15; ++i)
    {
        std::this_thread::sleep_for(std::chrono::milliseconds(200));
        auto outs = findPortsMatching({"sooperlooper", "SooperLooper", "common_out"}, false);
        if (!outs.empty())
            break;
    }
    return true;
}


bool AudioGraphManager::launchVocoder()
{
    if (processAlive(voc_pid_))
        return true;

    // Prefer headless jalv; fall back to jalv.gtk.
    std::string jalv = which(cfg_.jalv_binary.empty() ? "jalv" : cfg_.jalv_binary);
    if (jalv.empty())
        jalv = which("jalv.gtk");
    if (jalv.empty())
        jalv = which("jalv.gtk3");
    if (jalv.empty())
    {
        Logger::warning("jalv not found — install 'jalv' and 'calf-plugins' for Mode 2/3");
        return false;
    }

    // Verify the LV2 URI is installed (lv2ls).
    std::string lv2ls = which("lv2ls");
    if (!lv2ls.empty())
    {
        std::string listed = shellCapture(lv2ls + " 2>/dev/null");
        if (listed.find("Vocoder") == std::string::npos &&
            listed.find(cfg_.calf_vocoder_uri) == std::string::npos)
        {
            Logger::warning("Calf Vocoder LV2 URI not found in lv2ls — "
                            "is calf-plugins installed?");
            // Still try; some systems omit URI strings from lv2ls output format.
        }
    }

    pid_t pid = fork();
    if (pid < 0)
    {
        Logger::error("fork() failed for vocoder host");
        return false;
    }

    if (pid == 0)
    {
        // -n sets JACK/PipeWire node name prefix when supported.
        std::string pwjack = which("pw-jack");
        if (!pwjack.empty())
        {
            execlp("pw-jack", "pw-jack",
                   jalv.c_str(),
                   "-n", "InstrumentVocoder",
                   cfg_.calf_vocoder_uri.c_str(),
                   static_cast<char*>(nullptr));
        }
        execlp(jalv.c_str(), jalv.c_str(),
               "-n", "InstrumentVocoder",
               cfg_.calf_vocoder_uri.c_str(),
               static_cast<char*>(nullptr));
        _exit(127);
    }

    voc_pid_ = pid;
    Logger::info("Launched Calf Vocoder host pid=" + std::to_string(pid) +
                 " node=InstrumentVocoder");

    for (int i = 0; i < 20; ++i)
    {
        std::this_thread::sleep_for(std::chrono::milliseconds(200));
        auto outs = findPortsMatching(
            {"InstrumentVocoder", "Vocoder", "calf"}, false);
        if (!outs.empty())
            break;
    }
    return true;
}




bool AudioGraphManager::startProcesses()
{
    bool ok = launchZyn();
    launchZynDrums();
    launchSooperLooper();
    started_ = ok;
    return ok;
}




void AudioGraphManager::stopProcesses()
{
    disconnectAllOwnedLinks();
    killPid(voc_pid_, "vocoder");
    killPid(sl_pid_, "sooperlooper");
    killPid(zyn_drums_pid_, "zyn-drums");
    killPid(zyn_pid_, "zyn-melody");
    started_ = false;
}




bool AudioGraphManager::buildMode1()
{
    disconnectAllOwnedLinks();
    if (!processAlive(zyn_pid_) && !launchZyn())
        return false;
    launchZynDrums();
    if (!processAlive(sl_pid_))
        launchSooperLooper();

    // Wait until named clients show ports (runtime identity).
    for (int i = 0; i < 15; ++i) {
        bool mel = !findPortsMatching({cfg_.zyn_client_name}, false).empty();
        bool dru = !processAlive(zyn_drums_pid_) ||
                   !findPortsMatching({cfg_.zyn_drums_client_name}, false).empty();
        if (mel && dru)
            break;
        std::this_thread::sleep_for(std::chrono::milliseconds(100));
    }

    std::string mel_l = cfg_.zyn_client_name + ":out_1";
    std::string mel_r = cfg_.zyn_client_name + ":out_2";
    std::string dr_l = cfg_.zyn_drums_client_name + ":out_1";
    std::string dr_r = cfg_.zyn_drums_client_name + ":out_2";

    std::string sl_in_l, sl_in_r, sl_out_l, sl_out_r;
    bool sl_ok = resolveLooperPorts(sl_in_l, sl_in_r, sl_out_l, sl_out_r);

    if (sl_ok) {
        linkStereoToLooper(mel_l, mel_r, sl_in_l, sl_in_r);
        if (processAlive(zyn_drums_pid_))
            linkStereoToLooper(dr_l, dr_r, sl_in_l, sl_in_r);
        std::string play_l = defaultPlaybackPort(true);
        std::string play_r = defaultPlaybackPort(false);
        if (!play_l.empty())
            pwLink(sl_out_l, play_l);
        if (!play_r.empty())
            pwLink(sl_out_r.empty() ? sl_out_l : sl_out_r, play_r);
        Logger::info("Mode1: zyn-melody + zyn-drums → SL → headphones");
    } else {
        std::string play_l = defaultPlaybackPort(true);
        std::string play_r = defaultPlaybackPort(false);
        if (!play_l.empty()) {
            pwLink(mel_l, play_l);
            if (processAlive(zyn_drums_pid_))
                pwLink(dr_l, play_l);
        }
        if (!play_r.empty()) {
            pwLink(mel_r, play_r);
            if (processAlive(zyn_drums_pid_))
                pwLink(dr_r, play_r);
        }
        Logger::warning("Mode1: SL missing — direct to headphones");
    }

    // MIDI: separate ports → separate Zyns (channel numbers irrelevant)
    std::string midi_mel = findEngineMidiPort();
    std::string midi_dru = findEngineDrumsMidiPort();
    Logger::info("MIDI melody port='" + midi_mel + "' → " + cfg_.zyn_client_name);
    Logger::info("MIDI drums  port='" + midi_dru + "' → " + cfg_.zyn_drums_client_name);
    if (!midi_mel.empty())
        pwLink(midi_mel, cfg_.zyn_client_name + ":midi_input");
    if (!midi_dru.empty() && processAlive(zyn_drums_pid_))
        pwLink(midi_dru, cfg_.zyn_drums_client_name + ":midi_input");

    return true;
}




bool AudioGraphManager::buildMode2()
{
    disconnectAllOwnedLinks();
    if (!processAlive(zyn_pid_) && !launchZyn())
        return false;
    launchZynDrums();
    if (!processAlive(sl_pid_))
        launchSooperLooper();

    MicInfo mic = queryMic();
    if (!mic.present) {
        Logger::warning("Mode2: no mic — fallback Mode1");
        return buildMode1();
    }
    for (const auto& p : mic.capture_ports)
        Logger::info("  mic: " + p);

    if (!processAlive(voc_pid_))
        launchVocoder();
    // Wait for vocoder ports
    for (int i = 0; i < 20; ++i) {
        auto vin = findPortsMatching({"InstrumentVocoder"}, true);
        if (!vin.empty())
            break;
        std::this_thread::sleep_for(std::chrono::milliseconds(100));
    }

    auto lower = [](std::string s) {
        for (char& c : s)
            c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
        return s;
    };
    std::string vin_l, vin_r, vside, vout_l, vout_r;
    for (const auto& p : findPortsMatching({"InstrumentVocoder", "Vocoder"}, true)) {
        auto l = lower(p);
        if (l.find("events") != std::string::npos)
            continue;
        if (vin_l.empty() && l.find("in_l") != std::string::npos)
            vin_l = p;
        else if (vin_r.empty() && l.find("in_r") != std::string::npos)
            vin_r = p;
        else if (l.find("sidechain") != std::string::npos) {
            if (vside.empty() || l.find("sidechain2") == std::string::npos)
                vside = p;
        }
    }
    for (const auto& p : findPortsMatching({"InstrumentVocoder", "Vocoder"}, false)) {
        auto l = lower(p);
        if (l.find("events") != std::string::npos)
            continue;
        if (vout_l.empty() && l.find("out_l") != std::string::npos)
            vout_l = p;
        else if (vout_r.empty() && l.find("out_r") != std::string::npos)
            vout_r = p;
    }
    Logger::info("Vocoder: " + vin_l + " / " + vin_r + " mod=" + vside +
                 " out=" + vout_l + "/" + vout_r);

    std::string mel_l = cfg_.zyn_client_name + ":out_1";
    std::string mel_r = cfg_.zyn_client_name + ":out_2";
    std::string dr_l = cfg_.zyn_drums_client_name + ":out_1";
    std::string dr_r = cfg_.zyn_drums_client_name + ":out_2";

    std::string sl_in_l, sl_in_r, sl_out_l, sl_out_r;
    bool sl_ok = resolveLooperPorts(sl_in_l, sl_in_r, sl_out_l, sl_out_r);
    bool voc_ok = processAlive(voc_pid_) && !vin_l.empty() && !vout_l.empty();

    if (voc_ok) {
        // Melody instance ONLY → vocoder
        pwLink(mel_l, vin_l);
        if (!vin_r.empty())
            pwLink(mel_r, vin_r);
        // Mic → modulator (one copy of the capture stream)
        if (!vside.empty() && !mic.capture_ports.empty())
            pwLink(mic.capture_ports[0], vside);
        // Vocoder wet → SL
        if (sl_ok)
            linkStereoToLooper(vout_l, vout_r.empty() ? vout_l : vout_r,
                               sl_in_l, sl_in_r);
        Logger::info("Mode2: zyn-melody → vocoder → SL");
    } else if (sl_ok) {
        linkStereoToLooper(mel_l, mel_r, sl_in_l, sl_in_r);
        Logger::warning("Mode2: vocoder unavailable — melody dry → SL");
    }

    // Drums instance ALWAYS → SL, never vocoder
    if (processAlive(zyn_drums_pid_) && sl_ok) {
        linkStereoToLooper(dr_l, dr_r, sl_in_l, sl_in_r);
        Logger::info("Mode2: zyn-drums → SL (not vocoded)");
    }

    if (sl_ok) {
        std::string play_l = defaultPlaybackPort(true);
        std::string play_r = defaultPlaybackPort(false);
        if (!play_l.empty())
            pwLink(sl_out_l, play_l);
        if (!play_r.empty())
            pwLink(sl_out_r.empty() ? sl_out_l : sl_out_r, play_r);
    }

    std::string midi_mel = findEngineMidiPort();
    std::string midi_dru = findEngineDrumsMidiPort();
    if (!midi_mel.empty())
        pwLink(midi_mel, cfg_.zyn_client_name + ":midi_input");
    if (!midi_dru.empty() && processAlive(zyn_drums_pid_))
        pwLink(midi_dru, cfg_.zyn_drums_client_name + ":midi_input");

    Logger::info("Graph Mode2 complete");
    return true;
}





bool AudioGraphManager::buildMode3()
{
    // Mode 2 graph, then a SECOND link of the same mic capture → headphones
    // (PipeWire allows one source to multiple sinks = "two copies").
    if (!buildMode2())
        return false;

    MicInfo mic = queryMic();
    if (!mic.present || mic.capture_ports.empty()) {
        Logger::warning("Mode3: no mic for dry path");
        return true;
    }
    std::string play_l = defaultPlaybackPort(true);
    std::string play_r = defaultPlaybackPort(false);
    // Dry copy of mic (wet copy already feeds vocoder sidechain from Mode2)
    if (!play_l.empty())
        pwLink(mic.capture_ports[0], play_l);
    if (mic.capture_ports.size() > 1 && !play_r.empty())
        pwLink(mic.capture_ports[1], play_r);
    else if (!play_r.empty())
        pwLink(mic.capture_ports[0], play_r);

    Logger::info("Mode3: dry mic → headphones (parallel to vocoder wet path)");
    return true;
}




bool AudioGraphManager::setMode(PerformanceMode mode)
{
    mode_ = mode;
    switch (mode)
    {
        case PerformanceMode::SynthOnly:
            return buildMode1();
        case PerformanceMode::VocoderOnly:
            return buildMode2();
        case PerformanceMode::SynthAndVocoder:
            return buildMode3();
    }
    return buildMode1();
}




std::string AudioGraphManager::statusSummary() const
{
    std::ostringstream ss;
    ss << "mode=";
    switch (mode_) {
    case PerformanceMode::SynthOnly: ss << "SynthOnly"; break;
    case PerformanceMode::VocoderOnly: ss << "VocoderOnly"; break;
    case PerformanceMode::SynthAndVocoder: ss << "SynthAndVocoder"; break;
