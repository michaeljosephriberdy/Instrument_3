        if (play_r.empty())
            play_r = "alsa_output.pci-0000_04_00.6.HiFi__Headphones__sink:playback_FR";
        std::string ol = resolveClientPort(cfg_.zyn_drums_client_name, "out_1", false);
        std::string or_ = resolveClientPort(cfg_.zyn_drums_client_name, "out_2", false);
        if (ol.empty()) ol = "zynaddsubfx_zyn-drums:out_1";
        if (or_.empty()) or_ = "zynaddsubfx_zyn-drums:out_2";
        pwUnlink(ol, play_l); pwUnlink(or_, play_r);
    }
            break;
        }
    }
    return true;
}





bool AudioGraphManager::launchSooperLooper()
{
    if (processAlive(sl_pid_))
        return true;

    std::string bin = which(cfg_.sooperlooper_binary.empty()
                                ? "sooperlooper"
                                : cfg_.sooperlooper_binary);
    if (bin.empty())
    {
        Logger::warning("sooperlooper not found — install package 'sooperlooper'; "
                        "loop keys will log only");
        return false;
    }

    pid_t pid = fork();
    if (pid < 0)
    {
        Logger::error("fork() failed for SooperLooper");
        return false;
    }

    if (pid == 0)
    {
        // Headless: -p OSC port, -l 4 four independent loops, -c 2 stereo channels.
        // Do not pass -j (JACK name) in a way that breaks PipeWire.
        std::string port = std::to_string(cfg_.sooperlooper_osc_port);
        std::string pwjack = which("pw-jack");
        if (!pwjack.empty())
        {
            execlp("pw-jack", "pw-jack",
                   bin.c_str(),
                   "-p", port.c_str(),
 "-l", "4",
 "-c", "2",
 static_cast<char*>(nullptr));
 }
 execlp(bin.c_str(), bin.c_str(),
 "-p", port.c_str(),
 "-l", "4",
 "-c", "2",
 static_cast<char*>(nullptr));
        _exit(127);
    }

    sl_pid_ = pid;
    Logger::info("Launched SooperLooper pid=" + std::to_string(pid) +
                 " OSC :" + std::to_string(cfg_.sooperlooper_osc_port));

    // Wait for PipeWire ports to appear.
    for (int i = 0; i < 15; ++i)
    {
        std::this_thread::sleep_for(std::chrono::milliseconds(200));
        auto outs = findPortsMatching({"sooperlooper", "SooperLooper", "common_out"}, false);
        if (!outs.empty())
            break;
    }
    return true;
}


bool AudioGraphManager::launchVocoder()
{
    if (processAlive(voc_pid_))
        return true;

    // Prefer headless jalv; fall back to jalv.gtk.
    std::string jalv = which(cfg_.jalv_binary.empty() ? "jalv" : cfg_.jalv_binary);
    if (jalv.empty())
        jalv = which("jalv.gtk");
    if (jalv.empty())
        jalv = which("jalv.gtk3");
    if (jalv.empty())
    {
        Logger::warning("jalv not found — install 'jalv' and 'calf-plugins' for Mode 2/3");
        return false;
    }

    // Verify the LV2 URI is installed (lv2ls).
    std::string lv2ls = which("lv2ls");
    if (!lv2ls.empty())
    {
        std::string listed = shellCapture(lv2ls + " 2>/dev/null");
        if (listed.find("Vocoder") == std::string::npos &&
            listed.find(cfg_.calf_vocoder_uri) == std::string::npos)
        {
            Logger::warning("Calf Vocoder LV2 URI not found in lv2ls — "
                            "is calf-plugins installed?");
            // Still try; some systems omit URI strings from lv2ls output format.
        }
    }

    pid_t pid = fork();
    if (pid < 0)
    {
        Logger::error("fork() failed for vocoder host");
        return false;
    }

    if (pid == 0)
    {
        // -n sets JACK/PipeWire node name prefix when supported.
        // [vocoder-diag] Without this, a launch failure (missing jalv,
        // wrong LV2 URI, plugin load error, etc.) vanishes into
        // whatever launched the instrument process, and Mode 2/3
        // just silently fall back to un-vocoded audio with no clue
        // why. Capture it so it's actually visible.
        (void)freopen("/tmp/instrument_vocoder.log", "w", stdout);
        (void)freopen("/tmp/instrument_vocoder.log", "a", stderr);
        std::string pwjack = which("pw-jack");
        if (!pwjack.empty())
        {
            execlp("pw-jack", "pw-jack",
                   jalv.c_str(),
                   "-n", "InstrumentVocoder",
                   "-l", "config/calfvocoderpreset/state.ttl",
                   cfg_.calf_vocoder_uri.c_str(),
                   static_cast<char*>(nullptr));
        }
        execlp(jalv.c_str(), jalv.c_str(),
               "-n", "InstrumentVocoder",
               "-l", "config/calfvocoderpreset/state.ttl",
               cfg_.calf_vocoder_uri.c_str(),
               static_cast<char*>(nullptr));
        _exit(127);
    }

    voc_pid_ = pid;
    Logger::info("Launched Calf Vocoder host pid=" + std::to_string(pid) +
                 " node=InstrumentVocoder");
                 // [vocoder-diag] A plugin-load failure (e.g. wrong LV2 URI) makes
                 // jalv exit within milliseconds. Catch that immediately
                 // instead of only noticing later that no ports ever showed up.
                 std::this_thread::sleep_for(std::chrono::milliseconds(300));
                 if (!processAlive(voc_pid_)) {
                     int voc_status = 0;
                     waitpid(voc_pid_, &voc_status, WNOHANG);
                     std::string voc_tail = shellCapture("tail -n 20 /tmp/instrument_vocoder.log 2>/dev/null");
                     Logger::error("Vocoder host exited immediately after launch (pid=" +
                         std::to_string(voc_pid_) + "). This is why Mode 2/3 fall back to " +
                         "un-vocoded audio. Check jalv and the Calf Vocoder LV2 URI ('" +
                         cfg_.calf_vocoder_uri + "'). Run diag_mode23_preflight.sh for a " +
                         "full check. Last vocoder output:\n" + voc_tail);
                     voc_pid_ = -1;
                     return false;
                 }

    for (int i = 0; i < 20; ++i)
    {
        std::this_thread::sleep_for(std::chrono::milliseconds(200));
        auto outs = findPortsMatching(
            {"InstrumentVocoder", "Vocoder", "calf"}, false);
        if (!outs.empty())
            break;
    }
    return true;
}




bool AudioGraphManager::startProcesses()
{
    bool ok = launchZyn();
    launchZynDrums();
    launchSooperLooper();
    started_ = ok;
    return ok;
}




void AudioGraphManager::stopProcesses()
{
    disconnectAllOwnedLinks();
    killPid(voc_pid_, "vocoder");
    killPid(sl_pid_, "sooperlooper");
    killPid(zyn_drums_pid_, "zyn-drums");
    killPid(zyn_pid_, "zyn-melody");
    started_ = false;
}





// Force-remove every link this instrument cares about, including ones
// PipeWire auto-created when Zyn/SL/jalv started (those never landed in
// owned_links_, so disconnectAllOwnedLinks alone cannot clear them).
void AudioGraphManager::forceDisconnectInstrumentGraph()
{
    auto kill = [this](const std::string& src, const std::string& dst) {
        if (!src.empty() && !dst.empty())
            pwUnlink(src, dst);
    };

    // Resolve current port names (same helpers the builders use).
    std::string mel_l = resolveClientPort(cfg_.zyn_client_name, "out_1", false);
    std::string mel_r = resolveClientPort(cfg_.zyn_client_name, "out_2", false);
    std::string dr_l  = resolveClientPort(cfg_.zyn_drums_client_name, "out_1", false);
    std::string dr_r  = resolveClientPort(cfg_.zyn_drums_client_name, "out_2", false);
    if (mel_l.empty()) mel_l = "zynaddsubfx_zyn-melody:out_1";
    if (mel_r.empty()) mel_r = "zynaddsubfx_zyn-melody:out_2";
    if (dr_l.empty())  dr_l  = "zynaddsubfx_zyn-drums:out_1";
    if (dr_r.empty())  dr_r  = "zynaddsubfx_zyn-drums:out_2";

    std::string sl_in_l = "sooperlooper:common_in_1";
    std::string sl_in_r = "sooperlooper:common_in_2";
    std::string sl_out_l = "sooperlooper:common_out_1";
    std::string sl_out_r = "sooperlooper:common_out_2";
    {
        std::string a, b, c, d;
        if (resolveLooperPorts(a, b, c, d)) {
            sl_in_l = a; sl_in_r = b; sl_out_l = c; sl_out_r = d;
        }
    }

    std::string play_l = defaultPlaybackPort(true);
    std::string play_r = defaultPlaybackPort(false);
    if (play_l.empty())
        play_l = "alsa_output.pci-0000_04_00.6.HiFi__Headphones__sink:playback_FL";
    if (play_r.empty())
        play_r = "alsa_output.pci-0000_04_00.6.HiFi__Headphones__sink:playback_FR";

    const std::string vin_l  = "InstrumentVocoder:in_l";
    const std::string vin_r  = "InstrumentVocoder:in_r";
    const std::string vside  = "InstrumentVocoder:sidechain";
    const std::string vside2 = "InstrumentVocoder:sidechain2";
    const std::string vout_l = "InstrumentVocoder:out_l";
    const std::string vout_r = "InstrumentVocoder:out_r";

    // melody anywhere
    for (const auto& s : {mel_l, mel_r}) {
        kill(s, sl_in_l); kill(s, sl_in_r);
        kill(s, play_l);  kill(s, play_r);
        kill(s, vin_l);   kill(s, vin_r);
    }
    // drums anywhere
    for (const auto& s : {dr_l, dr_r}) {
        kill(s, sl_in_l); kill(s, sl_in_r);
        kill(s, play_l);  kill(s, play_r);
    }
    // vocoder outs anywhere
    for (const auto& s : {vout_l, vout_r}) {
        kill(s, sl_in_l); kill(s, sl_in_r);
        kill(s, play_l);  kill(s, play_r);
    }
    // mic anywhere (capture ports)
    MicInfo mic = queryMic();
    for (const auto& s : mic.capture_ports) {
        kill(s, vin_l); kill(s, vin_r);
        kill(s, vside); kill(s, vside2);
        kill(s, sl_in_l); kill(s, sl_in_r);
        kill(s, play_l);  kill(s, play_r);
    }
    // SL → headphones
    kill(sl_out_l, play_l);
    kill(sl_out_r, play_r);

    // Also clear owned_links_ tracking so we start clean.
    owned_links_.clear();
    Logger::info("forceDisconnectInstrumentGraph: cleared auto + owned links");
}


bool AudioGraphManager::buildMode1()
{
    // Mode 1 — final audio only (melody + drums).
    // Final rule: every final source → SL AND headphones (hear live + loop).
    disconnectAllOwnedLinks();
    forceDisconnectInstrumentGraph();

    if (!processAlive(zyn_pid_) && !launchZyn())
        return false;
    launchZynDrums();
    if (!processAlive(sl_pid_))
        launchSooperLooper();

    std::string mel_l = resolveClientPort(cfg_.zyn_client_name, "out_1", false);
    std::string mel_r = resolveClientPort(cfg_.zyn_client_name, "out_2", false);
    std::string dr_l  = resolveClientPort(cfg_.zyn_drums_client_name, "out_1", false);
    std::string dr_r  = resolveClientPort(cfg_.zyn_drums_client_name, "out_2", false);
    if (mel_l.empty()) mel_l = "zynaddsubfx_zyn-melody:out_1";
    if (mel_r.empty()) mel_r = "zynaddsubfx_zyn-melody:out_2";
    if (dr_l.empty())  dr_l  = "zynaddsubfx_zyn-drums:out_1";
    if (dr_r.empty())  dr_r  = "zynaddsubfx_zyn-drums:out_2";
    Logger::info("Resolved melody ports: " + mel_l + " / " + mel_r);
    Logger::info("Resolved drums ports: " + dr_l + " / " + dr_r);

    std::string sl_in_l, sl_in_r, sl_out_l, sl_out_r;
    if (!resolveLooperPorts(sl_in_l, sl_in_r, sl_out_l, sl_out_r)) {
        sl_in_l  = "sooperlooper:common_in_1";
        sl_in_r  = "sooperlooper:common_in_2";
        sl_out_l = "sooperlooper:common_out_1";
        sl_out_r = "sooperlooper:common_out_2";
    }
    Logger::info("SL ports in=" + sl_in_l + "/" + sl_in_r +
                 " out=" + sl_out_l + "/" + sl_out_r);

    std::string play_l = defaultPlaybackPort(true);
    std::string play_r = defaultPlaybackPort(false);
    if (play_l.empty())
        play_l = "alsa_output.pci-0000_04_00.6.HiFi__Headphones__sink:playback_FL";
    if (play_r.empty())
        play_r = "alsa_output.pci-0000_04_00.6.HiFi__Headphones__sink:playback_FR";
    Logger::info("Playback targets: " + play_l + " / " + play_r);

    // melody (final) → SL + headphones
    pwLink(mel_l, sl_in_l);
    pwLink(mel_r, sl_in_r);
    pwLink(mel_l, play_l);
    pwLink(mel_r, play_r);

    // drums (final) → SL + headphones
    if (processAlive(zyn_drums_pid_)) {
        pwLink(dr_l, sl_in_l);
        pwLink(dr_r, sl_in_r);
        pwLink(dr_l, play_l);
        pwLink(dr_r, play_r);
    }

    // SL → headphones
    pwLink(sl_out_l, play_l);
    pwLink(sl_out_r, play_r);

    Logger::info("Mode1: melody + drums → SL + headphones; SL → headphones");

    std::string midi_mel = findEngineMidiPort();
    std::string midi_dru = findEngineDrumsMidiPort();
    if (!midi_mel.empty())
        pwLink(midi_mel, resolveClientPort(cfg_.zyn_client_name, "midi_input", true));
    if (!midi_dru.empty() && processAlive(zyn_drums_pid_))
        pwLink(midi_dru, resolveClientPort(cfg_.zyn_drums_client_name, "midi_input", true));

    return true;
}

bool AudioGraphManager::buildMode2()
{
    // Mode 2 — VocoderOnly.
    // Intermediate: melody → vocoder carrier, mic → vocoder modulator.
    // Final:       vocoder out + drums → SL + headphones; SL → headphones.
    // NEVER link dry melody or dry mic to SL/headphones.
    disconnectAllOwnedLinks();
    forceDisconnectInstrumentGraph();

    if (!processAlive(zyn_pid_) && !launchZyn())
        return false;
    launchZynDrums();
    if (!processAlive(sl_pid_))
        launchSooperLooper();

    MicInfo mic = queryMic();
    if (!mic.present || mic.capture_ports.empty()) {
        std::string guess = shellCapture(
            "pw-link -o 2>/dev/null | grep -i 'alsa_input.*MVX2U.*capture' | head -n1");
        while (!guess.empty() &&
               (guess.back() == 10 || guess.back() == 13 || guess.back() == 32))
            guess.pop_back();
        if (!guess.empty()) {
            mic.present = true;
            mic.capture_ports = {guess};
            Logger::info("Mode2: mic fallback " + guess);
        } else {
            Logger::warning("Mode2: no mic — fallback Mode1");
            return buildMode1();
        }
    }
    for (const auto& p : mic.capture_ports)
        Logger::info("mic: " + p);

    if (!processAlive(voc_pid_))
        launchVocoder();
    for (int i = 0; i < 30; ++i) {
        auto vin = findPortsMatching({"InstrumentVocoder"}, true);
        if (!vin.empty())
            break;
        std::this_thread::sleep_for(std::chrono::milliseconds(100));
    }

    auto lower = [](std::string s) {
        for (char& c : s)
            c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
        return s;
    };
    std::string vin_l, vin_r, vside, vside2, vout_l, vout_r;
    for (const auto& p : findPortsMatching({"InstrumentVocoder"}, true)) {
        auto l = lower(p);
        if (l.find("events") != std::string::npos)
            continue;
        if (l.find("sidechain2") != std::string::npos)
            vside2 = p;
        else if (l.find("sidechain") != std::string::npos)
            vside = p;
        else if (vin_l.empty() && l.find("in_l") != std::string::npos)
            vin_l = p;
        else if (vin_r.empty() && l.find("in_r") != std::string::npos)
            vin_r = p;
    }
    for (const auto& p : findPortsMatching({"InstrumentVocoder"}, false)) {
        auto l = lower(p);
        if (l.find("events") != std::string::npos)
            continue;
        if (vout_l.empty() && l.find("out_l") != std::string::npos)
            vout_l = p;
        else if (vout_r.empty() && l.find("out_r") != std::string::npos)
            vout_r = p;
    }
    if (vin_l.empty())  vin_l  = "InstrumentVocoder:in_l";
    if (vin_r.empty())  vin_r  = "InstrumentVocoder:in_r";
    if (vside.empty())  vside  = "InstrumentVocoder:sidechain";
    if (vside2.empty()) vside2 = "InstrumentVocoder:sidechain2";
    if (vout_l.empty()) vout_l = "InstrumentVocoder:out_l";
    if (vout_r.empty()) vout_r = "InstrumentVocoder:out_r";
    Logger::info("Vocoder: " + vin_l + " / " + vin_r +
                 " mod=" + vside + "/" + vside2 +
                 " out=" + vout_l + "/" + vout_r);

    std::string mel_l = resolveClientPort(cfg_.zyn_client_name, "out_1", false);
    std::string mel_r = resolveClientPort(cfg_.zyn_client_name, "out_2", false);
    std::string dr_l  = resolveClientPort(cfg_.zyn_drums_client_name, "out_1", false);
    std::string dr_r  = resolveClientPort(cfg_.zyn_drums_client_name, "out_2", false);
    if (mel_l.empty()) mel_l = "zynaddsubfx_zyn-melody:out_1";
    if (mel_r.empty()) mel_r = "zynaddsubfx_zyn-melody:out_2";
    if (dr_l.empty())  dr_l  = "zynaddsubfx_zyn-drums:out_1";
    if (dr_r.empty())  dr_r  = "zynaddsubfx_zyn-drums:out_2";
    Logger::info("Resolved melody ports: " + mel_l + " / " + mel_r);
    Logger::info("Resolved drums ports: " + dr_l + " / " + dr_r);

    std::string sl_in_l, sl_in_r, sl_out_l, sl_out_r;
    if (!resolveLooperPorts(sl_in_l, sl_in_r, sl_out_l, sl_out_r)) {
        sl_in_l  = "sooperlooper:common_in_1";
        sl_in_r  = "sooperlooper:common_in_2";
        sl_out_l = "sooperlooper:common_out_1";
        sl_out_r = "sooperlooper:common_out_2";
    }
    Logger::info("SL ports in=" + sl_in_l + "/" + sl_in_r +
                 " out=" + sl_out_l + "/" + sl_out_r);

    std::string play_l = defaultPlaybackPort(true);
    std::string play_r = defaultPlaybackPort(false);
    if (play_l.empty())
        play_l = "alsa_output.pci-0000_04_00.6.HiFi__Headphones__sink:playback_FL";
    if (play_r.empty())
        play_r = "alsa_output.pci-0000_04_00.6.HiFi__Headphones__sink:playback_FR";
    Logger::info("Playback targets: " + play_l + " / " + play_r);

    bool voc_ok = processAlive(voc_pid_);
    if (!voc_ok) {
        Logger::error("Mode2: Calf Vocoder host not running — "
                      "falling back to un-vocoded Mode1 path. "
                      "Check /tmp/instrument_vocoder.log");
        pwLink(mel_l, sl_in_l);
        pwLink(mel_r, sl_in_r);
        pwLink(mel_l, play_l);
        pwLink(mel_r, play_r);
    } else {
        // INTERMEDIATE: carrier = melody → vocoder in (NOT to SL/headphones)
        pwLink(mel_l, vin_l);
        pwLink(mel_r, vin_r);
        // INTERMEDIATE: modulator = mic → sidechain (NOT to SL/headphones)
        const std::string& mic_p = mic.capture_ports[0];
        pwLink(mic_p, vside);
        pwLink(mic_p, vside2);
        Logger::info("Mode2: mic modulator " + mic_p +
                     " → " + vside + " + " + vside2);
        // FINAL: vocoder out → SL + headphones
        pwLink(vout_l, sl_in_l);
        pwLink(vout_r, sl_in_r);
        pwLink(vout_l, play_l);
        pwLink(vout_r, play_r);
        Logger::info("Mode2: vocoder out → SL + headphones");
    }

    // FINAL: drums → SL + headphones (never vocoded)
    if (processAlive(zyn_drums_pid_)) {
        pwLink(dr_l, sl_in_l);
        pwLink(dr_r, sl_in_r);
        pwLink(dr_l, play_l);
        pwLink(dr_r, play_r);
        Logger::info("Mode2: zyn-drums → SL + headphones (not vocoded)");
    }

    // SL → headphones
    pwLink(sl_out_l, play_l);
    pwLink(sl_out_r, play_r);

    std::string midi_mel = findEngineMidiPort();
    std::string midi_dru = findEngineDrumsMidiPort();
    if (!midi_mel.empty())
        pwLink(midi_mel, resolveClientPort(cfg_.zyn_client_name, "midi_input", true));
    if (!midi_dru.empty() && processAlive(zyn_drums_pid_))
        pwLink(midi_dru, resolveClientPort(cfg_.zyn_drums_client_name, "midi_input", true));

    Logger::info("Graph Mode2 complete");
    return true;
}

bool AudioGraphManager::buildMode3()
{
    // Mode 3 = Mode 2 + dry mic as FINAL audio (→ SL + headphones).
    if (!buildMode2())
        return false;

    MicInfo mic = queryMic();
    if (!mic.present || mic.capture_ports.empty()) {
        Logger::warning("Mode3: no mic for dry path");
        return true;
    }

    std::string sl_in_l, sl_in_r, sl_out_l, sl_out_r;
    if (!resolveLooperPorts(sl_in_l, sl_in_r, sl_out_l, sl_out_r)) {
        sl_in_l = "sooperlooper:common_in_1";
        sl_in_r = "sooperlooper:common_in_2";
    }

    std::string play_l = defaultPlaybackPort(true);
    std::string play_r = defaultPlaybackPort(false);
    if (play_l.empty())
        play_l = "alsa_output.pci-0000_04_00.6.HiFi__Headphones__sink:playback_FL";
    if (play_r.empty())
        play_r = "alsa_output.pci-0000_04_00.6.HiFi__Headphones__sink:playback_FR";

    // FINAL: dry mic → SL + headphones (parallel to vocoded wet path)
    const std::string& mic_p = mic.capture_ports[0];
    pwLink(mic_p, sl_in_l);
    pwLink(mic_p, sl_in_r);
    pwLink(mic_p, play_l);
    pwLink(mic_p, play_r);
    Logger::info("Mode3: dry mic → SL + headphones (parallel to vocoder wet path)");

    return true;
}


bool AudioGraphManager::buildMode4()
{
 // Mode 4 uses the same PipeWire routing as Mode 1.
 // Breath/volume policy is enforced in Engine (octave via nod;
 // chordal synth volume via SynthVol buttons → CC7).
 Logger::info("Building Mode4 (BreathOctave) — same routing as Mode1");
 return buildMode1();
}

bool AudioGraphManager::buildMode5()
{
 // Mode 5 = Mode 4 (synth+drums → SL + headphones) + dry mic → SL + headphones.
 if (!buildMode4())
 return false;

 MicInfo mic = queryMic();
 if (!mic.present || mic.capture_ports.empty()) {
 Logger::warning("Mode5: mic not present — synth-only until mic returns");
 return true;
 }

 std::string sl_in_l, sl_in_r, sl_out_l, sl_out_r;
 if (!resolveLooperPorts(sl_in_l, sl_in_r, sl_out_l, sl_out_r)) {
 sl_in_l = "sooperlooper:common_in_1";
 sl_in_r = "sooperlooper:common_in_2";
 }
 std::string play_l = defaultPlaybackPort(true);
 std::string play_r = defaultPlaybackPort(false);
 if (play_l.empty())
 play_l = "alsa_output.pci-0000_04_00.6.HiFi__Headphones__sink:playback_FL";
 if (play_r.empty())
 play_r = "alsa_output.pci-0000_04_00.6.HiFi__Headphones__sink:playback_FR";

 // Link EVERY capture port (mono devices expose one) to both SL and phones.
 for (const auto& mic_p : mic.capture_ports) {
 pwLink(mic_p, sl_in_l);
 pwLink(mic_p, sl_in_r);
 pwLink(mic_p, play_l);
 pwLink(mic_p, play_r);
 Logger::info("Mode5: dry mic " + mic_p + " → SL + headphones");
 }

 // Re-apply mixer so mic node gain is not left at 0 from a prior mode.
 applyMixerLevels(last_master_, last_dry_, last_vocoder_, last_drums_,
 last_synth_, last_mic_);
 return true;
}

bool AudioGraphManager::setMode(PerformanceMode mode)
{
    mode_ = mode;
    switch (mode)
    {
        case PerformanceMode::SynthOnly:
            return buildMode1();
        case PerformanceMode::VocoderOnly:
            return buildMode2();
        case PerformanceMode::SynthAndVocoder:
            return buildMode3();
    }
    return buildMode1();
}




std::string AudioGraphManager::statusSummary() const
{
    std::ostringstream ss;
    ss << "mode=";
    switch (mode_) {
    case PerformanceMode::SynthOnly: ss << "SynthOnly"; break;
    case PerformanceMode::VocoderOnly: ss << "VocoderOnly"; break;
    case PerformanceMode::SynthAndVocoder: ss << "SynthAndVocoder"; break;
 case PerformanceMode::BreathOctave: ss << "BreathOctave"; break;
 case PerformanceMode::BreathOctaveMic: ss << "BreathOctaveMic"; break;
    }
    ss << " melody=" << (processAlive(zyn_pid_) ? "up" : "down")
       << " drums=" << (processAlive(zyn_drums_pid_) ? "up" : "down")
       << " sl=" << (sooperlooperRunning() ? "up" : "down")
       << " voc=" << (vocoderRunning() ? "up" : "down")
       << " mic=" << (micPresent() ? "yes" : "no")
       << " links=" << owned_links_.size();
    return ss.str();
}



// --- Looper OSC ---------------------------------------------------------
// SooperLooper runs with 4 independent loops (-l 4). Per-loop control
// uses /sl/<track>/hit (track 0..3); the "armed" loop (default 0,
// re-armed by Record on that track) is the target for the shared
// Overdub/Undo controls. Mute All addresses SooperLooper's broadcast
// loop index (-1) so it only silences the loops -- never live Zyn.
// Prefer `oscsend` if present; otherwise log (see sendLooperOsc()).
namespace
{
 std::string loopHitPath(int track)
 {
     return "/sl/" + std::to_string(track) + "/hit";
 }
}




void AudioGraphManager::looperRecordTrack(int track)
{
    if (track < 0 || track > 3)
        return;
    if (!processAlive(sl_pid_)) {
        if (!launchSooperLooper()) {
            Logger::info("Looper Record (SooperLooper unavailable)");
            return;
        }
    }
    connectLooperGraph();

    // Single-loop model: only track 0 holds audio. Tracks 1..3 are overdub.
    if (track == 0) {
        armed_loop_ = 0;
        cycle_master_ = 0;
        sendLooperOsc(loopHitPath(0), "s", "record");
        Logger::info("Looper: BASE record toggle on loop 0");
        return;
    }

    // Secondary "record" keys -> overdub onto the base loop.
    armed_loop_ = 0;
    cycle_master_ = 0;
    sendLooperOsc(loopHitPath(0), "s", "overdub");
    Logger::info("Looper: OVERDUB toggle on loop 0 (from track " +
                 std::to_string(track) + " key)");
}









void AudioGraphManager::looperMuteTrack(int track)
{
    if (track < 0 || track > 3)
        return;
    if (!processAlive(sl_pid_)) {
        Logger::info("Looper Mute (SooperLooper not running)");
        return;
    }
    // One audible loop only.
    (void)track;
    sendLooperOsc(loopHitPath(0), "s", "mute");
    Logger::info("Looper: mute toggle on loop 0");
}



void AudioGraphManager::looperClearTrack(int track)
{
    if (track < 0 || track > 3)
        return;
    if (!processAlive(sl_pid_)) {
        Logger::info("Looper Clear (SooperLooper not running)");
        return;
    }

    if (track == 0) {
        // Wipe the whole base loop (all overdub layers go with it).
        sendLooperOsc(loopHitPath(0), "s", "undo_all");
        // Some SL builds use "clear" instead of / in addition to undo_all.
        sendLooperOsc(loopHitPath(0), "s", "clear");
        cycle_master_ = -1;
        armed_loop_ = 0;
        for (int t = 0; t < 4; ++t) {
            loop_active_[t] = false;
            loop_recording_[t] = false;
        }
        master_cycle_sec_ = 0.0;
        master_epoch_sec_ = 0.0;
        Logger::info("Looper: CLEAR base loop 0 (all layers)");
        return;
    }

    // Secondary clear keys -> undo last overdub layer on loop 0.
    sendLooperOsc(loopHitPath(0), "s", "undo");
    Logger::info("Looper: UNDO last overdub on loop 0 (from track " +
                 std::to_string(track) + " key)");
}



void AudioGraphManager::looperMuteAll()
{
    if (!processAlive(sl_pid_)) {
        Logger::info("Looper MuteAll (SooperLooper not running)");
        return;
    }
    sendLooperOsc(loopHitPath(0), "s", "mute");
    Logger::info("Looper: mute toggle on loop 0 (MuteAll)");
}


void AudioGraphManager::looperRecord() { looperRecordTrack(0); }
void AudioGraphManager::looperClear() { looperClearTrack(0); 
    noteAllLoopsCleared();
}

void AudioGraphManager::looperOverdub()
{
    if (!processAlive(sl_pid_)) {
        Logger::info("Looper Overdub (SooperLooper not running)");
        return;
    }
    connectLooperGraph();
    armed_loop_ = 0;
    sendLooperOsc(loopHitPath(0), "s", "overdub");
    Logger::info("Looper: OVERDUB toggle on loop 0");
}


void AudioGraphManager::looperPlay()
{
    if (!processAlive(sl_pid_))
    {
        Logger::info("Looper Play (SooperLooper not running)");
        return;
    }
    // 'trigger' starts playback from the beginning; 'pause' toggles.
    sendLooperOsc(loopHitPath(armed_loop_), "s", "trigger");
}
void AudioGraphManager::looperStop()
{
    if (!processAlive(sl_pid_))
    {
        Logger::info("Looper Stop (SooperLooper not running)");
        return;
    }
    // Pause if playing; mute as a hard silence fallback.
    sendLooperOsc(loopHitPath(armed_loop_), "s", "pause");
}

void AudioGraphManager::looperUndo()
{
    if (!processAlive(sl_pid_)) {
        Logger::info("Looper Undo (SooperLooper not running)");
        return;
    }
    sendLooperOsc(loopHitPath(0), "s", "undo");
    Logger::info("Looper: UNDO on loop 0");
}




