    int rc = std::system(cmd.str().c_str());
    if (rc != 0)
    {
        Logger::warning("oscsend failed: " + path + " " + type_tags + " " + arg);
        return false;
    }
    Logger::info("Looper OSC: " + path + " " + type_tags + " " + arg);
    return true;
}


void AudioGraphManager::connectLooperGraph()
{
    if (!processAlive(sl_pid_))
        return;
    std::string in_l, in_r, out_l, out_r;
    if (!resolveLooperPorts(in_l, in_r, out_l, out_r))
        return;
    std::string play_l = defaultPlaybackPort(true);
    std::string play_r = defaultPlaybackPort(false);
    if (play_l.empty()) {
        play_l = "alsa_output.pci-0000_04_00.6.HiFi__Headphones__sink:playback_FL";
        Logger::warning("defaultPlaybackPort(L) empty; using Headphones fallback");
    }
    if (play_r.empty()) {
        play_r = "alsa_output.pci-0000_04_00.6.HiFi__Headphones__sink:playback_FR";
        Logger::warning("defaultPlaybackPort(R) empty; using Headphones fallback");
    }
    Logger::info("Playback targets: " + play_l + " / " + play_r);
    if (!play_l.empty())
        pwLink(out_l, play_l);
    if (!play_r.empty())
        pwLink(out_r.empty() ? out_l : out_r, play_r);
}


bool AudioGraphManager::resolveLooperPorts(std::string& in_l, std::string& in_r,
                                           std::string& out_l, std::string& out_r)
{
    in_l = in_r = out_l = out_r = "";
    if (!processAlive(sl_pid_))
        return false;
    auto filt = [](std::vector<std::string> ports) {
        std::vector<std::string> o;
        for (const auto& p : ports) {
            std::string low = p;
            for (char& c : low)
                c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
            if (low.find("midi-bridge") != std::string::npos)
                continue;
            o.push_back(p);
        }
        return o;
    };
    auto all_in = filt(findPortsMatching(
        {"sooperlooper:common_in", "common_in", "loop0_in"}, true));
    auto all_out = filt(findPortsMatching(
        {"sooperlooper:common_out", "common_out", "loop0_out"}, false));
    auto pick = [](const std::vector<std::string>& ports, bool left) {
        for (const auto& p : ports) {
            std::string low = p;
            for (char& c : low)
                c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
            if (left && (low.find("_1") != std::string::npos || low.find("_l") != std::string::npos))
                return p;
            if (!left && (low.find("_2") != std::string::npos || low.find("_r") != std::string::npos))
                return p;
        }
        return ports.empty() ? std::string() : ports[0];
    };
    in_l = pick(all_in, true);
    in_r = pick(all_in, false);
    out_l = pick(all_out, true);
    out_r = pick(all_out, false);
    if (in_l.empty()) in_l = "sooperlooper:common_in_1";
    if (in_r.empty()) in_r = "sooperlooper:common_in_2";
    if (out_l.empty()) out_l = "sooperlooper:common_out_1";
    if (out_r.empty()) out_r = "sooperlooper:common_out_2";
    Logger::info("SL ports in=" + in_l + "/" + in_r + " out=" + out_l + "/" + out_r);
    return true;
}

void AudioGraphManager::linkStereoToLooper(const std::string& src_l,
                                           const std::string& src_r,
                                           const std::string& sl_in_l,
                                           const std::string& sl_in_r)
{
    if (src_l.empty() || sl_in_l.empty())
        return;
    pwLink(src_l, sl_in_l);
    if (!src_r.empty() && !sl_in_r.empty())
        pwLink(src_r, sl_in_r);
    else if (!src_r.empty())
        pwLink(src_r, sl_in_l);
}







bool AudioGraphManager::setNodeVolume(const std::string& node_name_substring,
                                      float linear)
{
    if (linear < 0.f) linear = 0.f;
    if (linear > 1.f) linear = 1.f;

    std::string pactl = which("pactl");
    if (!pactl.empty())
    {
        std::string sinks = shellCapture(pactl + " list short sinks 2>/dev/null");
        std::istringstream ss(sinks);
        std::string line;
        while (std::getline(ss, line))
        {
            if (line.find(node_name_substring) == std::string::npos)
                continue;
            std::istringstream ls(line);
            std::string id, name;
            ls >> id >> name;
            int percent = static_cast<int>(linear * 100.0f + 0.5f);
            std::string setcmd = pactl + " set-sink-volume " + id + " " +
                                 std::to_string(percent) + "% 2>/dev/null";
            if (std::system(setcmd.c_str()) == 0)
            {
                Logger::info("Volume " + name + " -> " + std::to_string(percent) + "%");
                return true;
            }
        }
    }

    Logger::debug("setNodeVolume '" + node_name_substring + "' linear=" +
                  std::to_string(linear) + " (no matching sink; recorded only)");
    return false;
}

void AudioGraphManager::applyMixerLevels(int master, int dry, int vocoder, int drums,
 int synth, int mic)
{
    last_master_  = master;
    last_dry_     = dry;
    last_vocoder_ = vocoder;
    last_drums_   = drums;
 last_synth_ = synth;
 last_mic_ = mic;

    float m = master / 127.0f;
    float d = dry / 127.0f;
    float v = vocoder / 127.0f;
    // Dry/voice node gain is a fraction of the master ceiling.
    float dry_final = d * m;
    // Vocoder gain is a fraction of the dry/voice level (relative to
    // voice), not an independent absolute -- it rides on dry_final.
    float vocoder_final = v * dry_final;

    Logger::info(
        "Mixer apply master=" + std::to_string(master) +
        " dry=" + std::to_string(dry) +
        " vocoder=" + std::to_string(vocoder) +
        " drums=" + std::to_string(drums));

    std::string wpctl = which("wpctl");
    if (!wpctl.empty())
    {
        std::ostringstream cmd;
        cmd << wpctl << " set-volume @DEFAULT_AUDIO_SINK@ " << m << " 2>/dev/null";
        if (std::system(cmd.str().c_str()) == 0)
            Logger::info("Master -> DEFAULT_AUDIO_SINK " + std::to_string(m));
    }
    else
    {
        setNodeVolume("analog-stereo", m);
    }

    setNodeVolume("InstrumentVocoder", vocoder_final);
    if (!cfg_.mic_name_hint.empty())
        {
 // mic mix gates capture level for Modes 2/3/5
 float mic_final = dry_final * (static_cast<float>(mic) / 127.0f);
 setNodeVolume(cfg_.mic_name_hint, mic_final);
}
    // NOTE: 'drums' is intentionally not applied to any PipeWire node
    // here -- drum loudness is a MIDI-velocity path, not an audio-graph
    // gain: Engine::handleAction's ActionType::Drum case scales note-on
    // velocity by (drumMix/127) * (masterVolume/127) directly. Breath
    // and vocoder gain never touch that path.
}


