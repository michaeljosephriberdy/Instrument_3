 }

 std::string sl_in_l, sl_in_r, sl_out_l, sl_out_r;
 if (!resolveLooperPorts(sl_in_l, sl_in_r, sl_out_l, sl_out_r)) {
 sl_in_l = "sooperlooper:common_in_1";
 sl_in_r = "sooperlooper:common_in_2";
 sl_out_l = "sooperlooper:common_out_1";
 sl_out_r = "sooperlooper:common_out_2";
 }

 std::string play_l = defaultPlaybackPort(true);
 std::string play_r = defaultPlaybackPort(false);
 const std::string pci_l =
 PI_AUDIO_LEFT_SINK;
 const std::string pci_r =
 PI_AUDIO_RIGHT_SINK;
 if (play_l.empty() || play_l.find("MVX2U") != std::string::npos)
 play_l = pci_l;
 if (play_r.empty() || play_r.find("MVX2U") != std::string::npos)
 play_r = pci_r;

 pwLink(mel_l, mvx_l);
 pwLink(mel_r, mvx_r);
 Logger::info("Mode6: melody → MVX2U");

 MicInfo mic = queryMic();
 if (mic.present && !mic.capture_ports.empty()) {
 for (const auto& mic_p : mic.capture_ports) {
 pwLink(mic_p, sl_in_l);
 pwLink(mic_p, sl_in_r);
 pwLink(mic_p, play_l);
 pwLink(mic_p, play_r);
 Logger::info("Mode6: mic " + mic_p + " → SL + headphones");
 }
 } else {
 Logger::warning("Mode6: no mic capture ports");
 }

 if (processAlive(zyn_drums_pid_)) {
 pwLink(dr_l, sl_in_l);
 pwLink(dr_r, sl_in_r);
 pwLink(dr_l, play_l);
 pwLink(dr_r, play_r);
 Logger::info("Mode6: drums → SL + headphones");
 }

 pwLink(sl_out_l, play_l);
 pwLink(sl_out_r, play_r);

 std::string midi_mel = findEngineMidiPort();
 std::string midi_dru = findEngineDrumsMidiPort();
 if (!midi_mel.empty())
 pwLink(midi_mel, resolveClientPort(cfg_.zyn_client_name, "midi_input", true));
 if (!midi_dru.empty() && processAlive(zyn_drums_pid_))
 pwLink(midi_dru, resolveClientPort(cfg_.zyn_drums_client_name, "midi_input", true));

 Logger::info("Graph Mode6 (Talkbox) complete");
 return true;
}

bool AudioGraphManager::ensureMvx2uMicCaptureLive()
{
 // Mic CAPTURE into the Pi only. Does not change Monitor Mix (jack blend)
 // or phantom power (HID / hardware preset).
 //
 // Symptom this fixes: ALSA "Microphone" Capture left at 0% so every mic
 // mode is silent even though PipeWire links look correct.

 // ALSA capture gain (card name and numeric fallback)
 (void)std::system("amixer -c MVX2U sset Microphone 80% unmute 2>/dev/null");
 (void)std::system("amixer -c 3 sset Microphone 80% unmute 2>/dev/null");

 // PipeWire source: unmute + set volume on every "Shure MVX2U" source node
 (void)std::system(
 "wpctl status 2>/dev/null | "
 "sed -n 's/.*\\([0-9][0-9]*\\)\\. Shure MVX2U.*/\\1/p' | "
 "while read -r id; do "
 "wpctl set-mute \"$id\" 0 2>/dev/null; "
 "wpctl set-volume \"$id\" 0.85 2>/dev/null; "
 "done");

 Logger::info("MVX2U: mic capture forced live (ALSA Microphone 80% + PW unmute)");
 return true;
}

