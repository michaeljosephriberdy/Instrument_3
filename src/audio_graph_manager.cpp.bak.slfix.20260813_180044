bool AudioGraphManager::launchSooperLooper()
{
    if (processAlive(sl_pid_))
        return true;

    std::string bin = which(cfg_.sooperlooper_binary.empty()
                                ? "sooperlooper"
                                : cfg_.sooperlooper_binary);
    if (bin.empty())
    {
        Logger::warning("sooperlooper not found — install package 'sooperlooper'; "
                        "loop keys will log only");
        return false;
    }

    pid_t pid = fork();
    if (pid < 0)
    {
        Logger::error("fork() failed for SooperLooper");
        return false;
    }

    if (pid == 0)
    {
        // Headless: -p OSC port, -l 4 four independent loops, -c 2 stereo channels.
        // Do not pass -j (JACK name) in a way that breaks PipeWire.
        std::string port = std::to_string(cfg_.sooperlooper_osc_port);
        std::string pwjack = which("pw-jack");
        if (!pwjack.empty())
        {
            execlp("pw-jack", "pw-jack",
                   bin.c_str(),
                   "-p", port.c_str(),
 "-l", "4",
 "-c", "2",
 static_cast<char*>(nullptr));
 }
 execlp(bin.c_str(), bin.c_str(),
 "-p", port.c_str(),
 "-l", "4",
 "-c", "2",
 static_cast<char*>(nullptr));
        _exit(127);
    }

    sl_pid_ = pid;
    Logger::info("Launched SooperLooper pid=" + std::to_string(pid) +
                 " OSC :" + std::to_string(cfg_.sooperlooper_osc_port));

    // Wait for PipeWire ports to appear.
    for (int i = 0; i < 15; ++i)
    {
        std::this_thread::sleep_for(std::chrono::milliseconds(200));
        auto outs = findPortsMatching({"sooperlooper", "SooperLooper", "common_out"}, false);
        if (!outs.empty())
            break;
    }
    return true;
}


bool AudioGraphManager::launchVocoder()
{
    if (processAlive(voc_pid_))
        return true;

    // Prefer headless jalv; fall back to jalv.gtk.
    std::string jalv = which(cfg_.jalv_binary.empty() ? "jalv" : cfg_.jalv_binary);
    if (jalv.empty())
        jalv = which("jalv.gtk");
    if (jalv.empty())
        jalv = which("jalv.gtk3");
    if (jalv.empty())
    {
        Logger::warning("jalv not found — install 'jalv' and 'calf-plugins' for Mode 2/3");
        return false;
    }

    // Verify the LV2 URI is installed (lv2ls).
    std::string lv2ls = which("lv2ls");
    if (!lv2ls.empty())
    {
        std::string listed = shellCapture(lv2ls + " 2>/dev/null");
        if (listed.find("Vocoder") == std::string::npos &&
            listed.find(cfg_.calf_vocoder_uri) == std::string::npos)
        {
            Logger::warning("Calf Vocoder LV2 URI not found in lv2ls — "
                            "is calf-plugins installed?");
            // Still try; some systems omit URI strings from lv2ls output format.
        }
    }

    pid_t pid = fork();
    if (pid < 0)
    {
        Logger::error("fork() failed for vocoder host");
        return false;
    }

    if (pid == 0) {
        // Log jalv stdout/stderr so Mode 2/3 failures are diagnosable.
        (void)freopen("/tmp/instrument_vocoder.log", "w", stdout);
        (void)freopen("/tmp/instrument_vocoder.log", "a", stderr);

        // VOCODER_STDIN_KEEPALIVE
        // jalv reads an interactive command stream from stdin and exits
        // cleanly (status 0) on EOF. Under systemd the forked child has
        // stdin already closed/at EOF, so jalv prints control ports and
        // quits within milliseconds -- the headless "Vocoder host exited
        // immediately" loop. Hold a pipe write end open across exec so
        // stdin never EOFs.
        int keep_stdin[2] = {-1, -1};
        if (pipe(keep_stdin) == 0) {
            (void)dup2(keep_stdin[0], STDIN_FILENO);
            (void)close(keep_stdin[0]);
            // keep_stdin[1] intentionally left open (no FD_CLOEXEC)
        }

        {
            std::string pwjack = which("pw-jack");
            if (!pwjack.empty()) {
                execlp("pw-jack", "pw-jack",
                       jalv.c_str(),
                       "-n", "InstrumentVocoder",
                       "-l", "config/calfvocoderpreset/state.ttl",
                       cfg_.calf_vocoder_uri.c_str(),
                       static_cast<char*>(nullptr));
            }
            execlp(jalv.c_str(), jalv.c_str(),
                   "-n", "InstrumentVocoder",
                   "-l", "config/calfvocoderpreset/state.ttl",
                   cfg_.calf_vocoder_uri.c_str(),
                   static_cast<char*>(nullptr));
        }
        _exit(127);
    }

    voc_pid_ = pid;
    Logger::info("Launched Calf Vocoder host pid=" + std::to_string(pid) +
                 " node=InstrumentVocoder");
                 // [vocoder-diag] A plugin-load failure (e.g. wrong LV2 URI) makes
                 // jalv exit within milliseconds. Catch that immediately
                 // instead of only noticing later that no ports ever showed up.
                 std::this_thread::sleep_for(std::chrono::milliseconds(300));
                 if (!processAlive(voc_pid_)) {
                     int voc_status = 0;
                     waitpid(voc_pid_, &voc_status, WNOHANG);
                     std::string voc_tail = shellCapture("tail -n 20 /tmp/instrument_vocoder.log 2>/dev/null");
                     Logger::error("Vocoder host exited immediately after launch (pid=" +
                         std::to_string(voc_pid_) + "). This is why Mode 2/3 fall back to " +
                         "un-vocoded audio. Check jalv and the Calf Vocoder LV2 URI ('" +
                         cfg_.calf_vocoder_uri + "'). Run diag_mode23_preflight.sh for a " +
                         "full check. Last vocoder output:\n" + voc_tail);
                     voc_pid_ = -1;
                     return false;
                 }

    for (int i = 0; i < 20; ++i)
    {
        std::this_thread::sleep_for(std::chrono::milliseconds(200));
        auto outs = findPortsMatching(
            {"InstrumentVocoder", "Vocoder", "calf"}, false);
        if (!outs.empty())
            break;
    }
    return true;
}




bool AudioGraphManager::startProcesses()
{
 // Launch everything once at instrument boot. Mode switches only rewire.
 bool ok = launchZyn();
 launchZynDrums();
 launchSooperLooper();
 launchVocoder(); // keep host alive; Mode 1 simply leaves it unlinked
 started_ = ok;
 // Ensure USB mic capture ports exist in PipeWire before first mode build (called before return -- was dead code)
    activateMicCapturePorts();
 ensureMvx2uMicCaptureLive();
    return ok;
}




void AudioGraphManager::stopProcesses()
{
    disconnectAllOwnedLinks();
    killPid(voc_pid_, "vocoder");
    killPid(sl_pid_, "sooperlooper");
    killPid(zyn_drums_pid_, "zyn-drums");
    killPid(zyn_pid_, "zyn-melody");
    started_ = false;
}





// Force-remove every link this instrument cares about, including ones
// PipeWire auto-created when Zyn/SL/jalv started (those never landed in
// owned_links_, so disconnectAllOwnedLinks alone cannot clear them).
void AudioGraphManager::forceDisconnectInstrumentGraph()
{
    auto kill = [this](const std::string& src, const std::string& dst) {
        if (!src.empty() && !dst.empty())
            pwUnlink(src, dst);
    };

    // Resolve current port names (same helpers the builders use).
    std::string mel_l = resolveClientPort(cfg_.zyn_client_name, "out_1", false);
    std::string mel_r = resolveClientPort(cfg_.zyn_client_name, "out_2", false);
    std::string dr_l  = resolveClientPort(cfg_.zyn_drums_client_name, "out_1", false);
    std::string dr_r  = resolveClientPort(cfg_.zyn_drums_client_name, "out_2", false);
    if (mel_l.empty()) mel_l = "zynaddsubfx_zyn-melody:out_1";
    if (mel_r.empty()) mel_r = "zynaddsubfx_zyn-melody:out_2";
    if (dr_l.empty())  dr_l  = "zynaddsubfx_zyn-drums:out_1";
    if (dr_r.empty())  dr_r  = "zynaddsubfx_zyn-drums:out_2";

    std::string sl_in_l = "sooperlooper:common_in_1";
    std::string sl_in_r = "sooperlooper:common_in_2";
    std::string sl_out_l = "sooperlooper:common_out_1";
    std::string sl_out_r = "sooperlooper:common_out_2";
    {
        std::string a, b, c, d;
        if (resolveLooperPorts(a, b, c, d)) {
            sl_in_l = a; sl_in_r = b; sl_out_l = c; sl_out_r = d;
        }
    }

    std::string play_l = defaultPlaybackPort(true);
    std::string play_r = defaultPlaybackPort(false);
    if (play_l.empty())
        play_l = PI_AUDIO_LEFT_SINK;
    if (play_r.empty())
        play_r = PI_AUDIO_RIGHT_SINK;

    const std::string vin_l  = "InstrumentVocoder:in_l";
    const std::string vin_r  = "InstrumentVocoder:in_r";
    const std::string vside  = "InstrumentVocoder:sidechain";
    const std::string vside2 = "InstrumentVocoder:sidechain2";
    const std::string vout_l = "InstrumentVocoder:out_l";
    const std::string vout_r = "InstrumentVocoder:out_r";

    // melody anywhere
    for (const auto& s : {mel_l, mel_r}) {
        kill(s, sl_in_l); kill(s, sl_in_r);
        kill(s, play_l);  kill(s, play_r);
        kill(s, vin_l);   kill(s, vin_r);
    }
    // drums anywhere
    for (const auto& s : {dr_l, dr_r}) {
        kill(s, sl_in_l); kill(s, sl_in_r);
        kill(s, play_l);  kill(s, play_r);
    }
    // vocoder outs anywhere
    for (const auto& s : {vout_l, vout_r}) {
        kill(s, sl_in_l); kill(s, sl_in_r);
        kill(s, play_l);  kill(s, play_r);
    }
    // mic anywhere (capture ports)
    MicInfo mic = queryMic();
    for (const auto& s : mic.capture_ports) {
        kill(s, vin_l); kill(s, vin_r);
        kill(s, vside); kill(s, vside2);
        kill(s, sl_in_l); kill(s, sl_in_r);
        kill(s, play_l);  kill(s, play_r);
    }
    // SL → headphones
    kill(sl_out_l, play_l);
    kill(sl_out_r, play_r);

    // Also clear owned_links_ tracking so we start clean.
    owned_links_.clear();
    Logger::info("forceDisconnectInstrumentGraph: cleared auto + owned links");
}


bool AudioGraphManager::buildMode1()
{
    // Mode 1 — final audio only (melody + drums).
    // Final rule: every final source → SL AND headphones (hear live + loop).
    disconnectAllOwnedLinks();
    forceDisconnectInstrumentGraph();

    if (!processAlive(zyn_pid_) && !launchZyn())
        return false;
    launchZynDrums();
    if (!processAlive(sl_pid_))
        launchSooperLooper();

    std::string mel_l = resolveClientPort(cfg_.zyn_client_name, "out_1", false);
    std::string mel_r = resolveClientPort(cfg_.zyn_client_name, "out_2", false);
    std::string dr_l  = resolveClientPort(cfg_.zyn_drums_client_name, "out_1", false);
    std::string dr_r  = resolveClientPort(cfg_.zyn_drums_client_name, "out_2", false);
    if (mel_l.empty()) mel_l = "zynaddsubfx_zyn-melody:out_1";
    if (mel_r.empty()) mel_r = "zynaddsubfx_zyn-melody:out_2";
    if (dr_l.empty())  dr_l  = "zynaddsubfx_zyn-drums:out_1";
    if (dr_r.empty())  dr_r  = "zynaddsubfx_zyn-drums:out_2";
    Logger::info("Resolved melody ports: " + mel_l + " / " + mel_r);
    Logger::info("Resolved drums ports: " + dr_l + " / " + dr_r);

    std::string sl_in_l, sl_in_r, sl_out_l, sl_out_r;
    if (!resolveLooperPorts(sl_in_l, sl_in_r, sl_out_l, sl_out_r)) {
        sl_in_l  = "sooperlooper:common_in_1";
        sl_in_r  = "sooperlooper:common_in_2";
        sl_out_l = "sooperlooper:common_out_1";
        sl_out_r = "sooperlooper:common_out_2";
    }
    Logger::info("SL ports in=" + sl_in_l + "/" + sl_in_r +
                 " out=" + sl_out_l + "/" + sl_out_r);

    std::string play_l = defaultPlaybackPort(true);
    std::string play_r = defaultPlaybackPort(false);
    if (play_l.empty())
        play_l = PI_AUDIO_LEFT_SINK;
    if (play_r.empty())
        play_r = PI_AUDIO_RIGHT_SINK;
    Logger::info("Playback targets: " + play_l + " / " + play_r);

    // melody (final) → SL + headphones
    pwLink(mel_l, sl_in_l);
    pwLink(mel_r, sl_in_r);
    pwLink(mel_l, play_l);
    pwLink(mel_r, play_r);

    // drums (final) → SL + headphones
    if (processAlive(zyn_drums_pid_)) {
        pwLink(dr_l, sl_in_l);
        pwLink(dr_r, sl_in_r);
        pwLink(dr_l, play_l);
        pwLink(dr_r, play_r);
    }

    // SL → headphones
    pwLink(sl_out_l, play_l);
    pwLink(sl_out_r, play_r);

    Logger::info("Mode1: melody + drums → SL + headphones; SL → headphones");

    std::string midi_mel = findEngineMidiPort();
    std::string midi_dru = findEngineDrumsMidiPort();
    if (!midi_mel.empty())
        pwLink(midi_mel, resolveClientPort(cfg_.zyn_client_name, "midi_input", true));
    if (!midi_dru.empty() && processAlive(zyn_drums_pid_))
        pwLink(midi_dru, resolveClientPort(cfg_.zyn_drums_client_name, "midi_input", true));

    return true;
}

bool AudioGraphManager::buildMode2()
{
 ensureMvx2uMicCaptureLive();
 // Ports/names refreshed every entry (and by ensureHealthyGraph).

    // Mode 2 — VocoderOnly.
    // Intermediate: melody → vocoder carrier, mic → vocoder modulator.
    // Final:       vocoder out + drums → SL + headphones; SL → headphones.
    // NEVER link dry melody or dry mic to SL/headphones.
    disconnectAllOwnedLinks();
    forceDisconnectInstrumentGraph();

    if (!processAlive(zyn_pid_) && !launchZyn())
        return false;
    launchZynDrums();
    if (!processAlive(sl_pid_))
        launchSooperLooper();

    MicInfo mic = queryMic();
    if (!mic.present || mic.capture_ports.empty()) {
        std::string guess = shellCapture(
            "pw-link -o 2>/dev/null | grep -i 'alsa_input.*MVX2U.*capture' | head -n1");
        while (!guess.empty() &&
               (guess.back() == 10 || guess.back() == 13 || guess.back() == 32))
            guess.pop_back();
        if (!guess.empty()) {
            mic.present = true;
            mic.capture_ports = {guess};
            Logger::info("Mode2: mic fallback " + guess);
        } else {
            Logger::warning("Mode2: no mic — fallback Mode1");
            return buildMode1();
        }
    }
    for (const auto& p : mic.capture_ports)
        Logger::info("mic: " + p);

    if (!processAlive(voc_pid_))
        launchVocoder();
    for (int i = 0; i < 30; ++i) {
        auto vin = findPortsMatching({"InstrumentVocoder"}, true);
        if (!vin.empty())
            break;
        std::this_thread::sleep_for(std::chrono::milliseconds(100));
    }

    auto lower = [](std::string s) {
        for (char& c : s)
            c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
        return s;
    };
    std::string vin_l, vin_r, vside, vside2, vout_l, vout_r;
    for (const auto& p : findPortsMatching({"InstrumentVocoder"}, true)) {
        auto l = lower(p);
        if (l.find("events") != std::string::npos)
            continue;
        if (l.find("sidechain2") != std::string::npos)
            vside2 = p;
        else if (l.find("sidechain") != std::string::npos)
            vside = p;
        else if (vin_l.empty() && l.find("in_l") != std::string::npos)
            vin_l = p;
        else if (vin_r.empty() && l.find("in_r") != std::string::npos)
            vin_r = p;
    }
    for (const auto& p : findPortsMatching({"InstrumentVocoder"}, false)) {
        auto l = lower(p);
        if (l.find("events") != std::string::npos)
            continue;
        if (vout_l.empty() && l.find("out_l") != std::string::npos)
            vout_l = p;
        else if (vout_r.empty() && l.find("out_r") != std::string::npos)
            vout_r = p;
    }
    if (vin_l.empty())  vin_l  = "InstrumentVocoder:in_l";
    if (vin_r.empty())  vin_r  = "InstrumentVocoder:in_r";
    if (vside.empty())  vside  = "InstrumentVocoder:sidechain";
    if (vside2.empty()) vside2 = "InstrumentVocoder:sidechain2";
    if (vout_l.empty()) vout_l = "InstrumentVocoder:out_l";
    if (vout_r.empty()) vout_r = "InstrumentVocoder:out_r";
    Logger::info("Vocoder: " + vin_l + " / " + vin_r +
                 " mod=" + vside + "/" + vside2 +
                 " out=" + vout_l + "/" + vout_r);

    std::string mel_l = resolveClientPort(cfg_.zyn_client_name, "out_1", false);
    std::string mel_r = resolveClientPort(cfg_.zyn_client_name, "out_2", false);
    std::string dr_l  = resolveClientPort(cfg_.zyn_drums_client_name, "out_1", false);
    std::string dr_r  = resolveClientPort(cfg_.zyn_drums_client_name, "out_2", false);
    if (mel_l.empty()) mel_l = "zynaddsubfx_zyn-melody:out_1";
    if (mel_r.empty()) mel_r = "zynaddsubfx_zyn-melody:out_2";
    if (dr_l.empty())  dr_l  = "zynaddsubfx_zyn-drums:out_1";
    if (dr_r.empty())  dr_r  = "zynaddsubfx_zyn-drums:out_2";
    Logger::info("Resolved melody ports: " + mel_l + " / " + mel_r);
    Logger::info("Resolved drums ports: " + dr_l + " / " + dr_r);

    std::string sl_in_l, sl_in_r, sl_out_l, sl_out_r;
    if (!resolveLooperPorts(sl_in_l, sl_in_r, sl_out_l, sl_out_r)) {
        sl_in_l  = "sooperlooper:common_in_1";
        sl_in_r  = "sooperlooper:common_in_2";
        sl_out_l = "sooperlooper:common_out_1";
        sl_out_r = "sooperlooper:common_out_2";
    }
    Logger::info("SL ports in=" + sl_in_l + "/" + sl_in_r +
                 " out=" + sl_out_l + "/" + sl_out_r);

    std::string play_l = defaultPlaybackPort(true);
    std::string play_r = defaultPlaybackPort(false);
    if (play_l.empty())
        play_l = PI_AUDIO_LEFT_SINK;
    if (play_r.empty())
        play_r = PI_AUDIO_RIGHT_SINK;
    Logger::info("Playback targets: " + play_l + " / " + play_r);

    bool voc_ok = processAlive(voc_pid_);
    if (!voc_ok) {
        Logger::error("Mode2: Calf Vocoder host not running — "
                      "falling back to un-vocoded Mode1 path. "
                      "Check /tmp/instrument_vocoder.log");
        pwLink(mel_l, sl_in_l);
        pwLink(mel_r, sl_in_r);
        pwLink(mel_l, play_l);
        pwLink(mel_r, play_r);
    } else {
        // INTERMEDIATE: carrier = melody → vocoder in (NOT to SL/headphones)
        pwLink(mel_l, vin_l);
        pwLink(mel_r, vin_r);
        // INTERMEDIATE: modulator = mic → sidechain (NOT to SL/headphones)
        const std::string& mic_p = mic.capture_ports[0];
        pwLink(mic_p, vside);
        pwLink(mic_p, vside2);
        Logger::info("Mode2: mic modulator " + mic_p +
                     " → " + vside + " + " + vside2);
        // FINAL: vocoder out → SL + headphones
        pwLink(vout_l, sl_in_l);
        pwLink(vout_r, sl_in_r);
        pwLink(vout_l, play_l);
        pwLink(vout_r, play_r);
        Logger::info("Mode2: vocoder out → SL + headphones");
    }

    // FINAL: drums → SL + headphones (never vocoded)
    if (processAlive(zyn_drums_pid_)) {
        pwLink(dr_l, sl_in_l);
        pwLink(dr_r, sl_in_r);
        pwLink(dr_l, play_l);
        pwLink(dr_r, play_r);
        Logger::info("Mode2: zyn-drums → SL + headphones (not vocoded)");
    }

    // SL → headphones
    pwLink(sl_out_l, play_l);
    pwLink(sl_out_r, play_r);

    std::string midi_mel = findEngineMidiPort();
    std::string midi_dru = findEngineDrumsMidiPort();
    if (!midi_mel.empty())
        pwLink(midi_mel, resolveClientPort(cfg_.zyn_client_name, "midi_input", true));
    if (!midi_dru.empty() && processAlive(zyn_drums_pid_))
        pwLink(midi_dru, resolveClientPort(cfg_.zyn_drums_client_name, "midi_input", true));

    Logger::info("Graph Mode2 complete");
    return true;
}

bool AudioGraphManager::buildMode3()
{
 ensureMvx2uMicCaptureLive();
    // Mode 3 = Mode 2 + dry mic as FINAL audio (→ SL + headphones).
    if (!buildMode2())
        return false;

    MicInfo mic = queryMic();
    if (!mic.present || mic.capture_ports.empty()) {
        Logger::warning("Mode3: no mic for dry path");
        return true;
    }

    std::string sl_in_l, sl_in_r, sl_out_l, sl_out_r;
    if (!resolveLooperPorts(sl_in_l, sl_in_r, sl_out_l, sl_out_r)) {
        sl_in_l = "sooperlooper:common_in_1";
        sl_in_r = "sooperlooper:common_in_2";
    }

    std::string play_l = defaultPlaybackPort(true);
    std::string play_r = defaultPlaybackPort(false);
    if (play_l.empty())
        play_l = PI_AUDIO_LEFT_SINK;
    if (play_r.empty())
        play_r = PI_AUDIO_RIGHT_SINK;

    // FINAL: dry mic → SL + headphones (parallel to vocoded wet path)
    const std::string& mic_p = mic.capture_ports[0];
    pwLink(mic_p, sl_in_l);
    pwLink(mic_p, sl_in_r);
    pwLink(mic_p, play_l);
    pwLink(mic_p, play_r);
    Logger::info("Mode3: dry mic → SL + headphones (parallel to vocoder wet path)");

    return true;
}


bool AudioGraphManager::buildMode4()
{
 // Mode 4 uses the same PipeWire routing as Mode 1.
 // Breath/volume policy is enforced in Engine (octave via nod;
 // chordal synth volume via SynthVol buttons → CC7).
 Logger::info("Building Mode4 (BreathOctave) — same routing as Mode1");
 return buildMode1();
}

bool AudioGraphManager::buildMode5()
{
 ensureMvx2uMicCaptureLive();
 if (!buildMode4())
 return false;

 if (!processAlive(sl_pid_))
 launchSooperLooper();

 // Fresh mic lookup every Mode5 entry (addresses change after unplug/replug)
 MicInfo mic = queryMic();
 if (!mic.present || mic.capture_ports.empty()) {
 Logger::warning("Mode5: mic has no capture ports (yet)");
 return true;
 }

 std::string sl_in_l, sl_in_r, sl_out_l, sl_out_r;
 if (!resolveLooperPorts(sl_in_l, sl_in_r, sl_out_l, sl_out_r)) {
 sl_in_l = "sooperlooper:common_in_1";
 sl_in_r = "sooperlooper:common_in_2";
 }
 std::string play_l = defaultPlaybackPort(true);
 std::string play_r = defaultPlaybackPort(false);
 if (play_l.empty())
 play_l = PI_AUDIO_LEFT_SINK;
 if (play_r.empty())
 play_r = PI_AUDIO_RIGHT_SINK;

 for (const auto& mic_p : mic.capture_ports) {
 pwLink(mic_p, sl_in_l);
 pwLink(mic_p, sl_in_r);
 pwLink(mic_p, play_l);
 pwLink(mic_p, play_r);
 Logger::info("Mode5: " + mic_p + " → SL + headphones");
 }
 return true;
}


void AudioGraphManager::ensureHealthyGraph() {
    // ------------------------------------------------------------------
    // 1) Refresh knowledge of every entity (even if unused in this mode)
    // ------------------------------------------------------------------
    MicInfo mic = queryMic(); // updates capture port names after unplug/replug

    // Playback targets can change if the user switches sinks
    std::string play_l = defaultPlaybackPort(true);
    std::string play_r = defaultPlaybackPort(false);
    if (play_l.empty())
        play_l = PI_AUDIO_LEFT_SINK;
    if (play_r.empty())
        play_r = PI_AUDIO_RIGHT_SINK;

    // ------------------------------------------------------------------
    // 2) Ensure processes exist (relaunch only if dead -- never kill healthy)
    // ------------------------------------------------------------------
    bool need_rebuild = false;
    if (!processAlive(zyn_pid_)) {
        Logger::warning("Health: melody Zyn dead -- relaunching");
        launchZyn();
        need_rebuild = true;
    }
    if (!processAlive(zyn_drums_pid_)) {
        Logger::warning("Health: drums Zyn dead -- relaunching");
        launchZynDrums();
        need_rebuild = true;
    }
    if (!processAlive(sl_pid_)) {
        Logger::warning("Health: SooperLooper dead -- relaunching");
        launchSooperLooper();
        need_rebuild = true;
    }
    if (!processAlive(voc_pid_)) {
        Logger::warning("Health: Vocoder host dead -- relaunching");
        launchVocoder();
        need_rebuild = true;
    }

    // ------------------------------------------------------------------
    // 3) Resolve ports; if any critical name vanished, force rebuild
    // ------------------------------------------------------------------
    std::string mel_l = resolveClientPort(cfg_.zyn_client_name, "out_1", false);
    std::string mel_r = resolveClientPort(cfg_.zyn_client_name, "out_2", false);
    if (mel_l.empty() || mel_r.empty()) {
        Logger::warning("Health: melody ports missing -- rebuild");
        need_rebuild = true;
    }
    std::string sl_in_l, sl_in_r, sl_out_l, sl_out_r;
    if (!resolveLooperPorts(sl_in_l, sl_in_r, sl_out_l, sl_out_r)) {
        Logger::warning("Health: SL ports missing -- rebuild");
        need_rebuild = true;
    }
    // Vocoder ports (always tracked; Mode 1 leaves them unlinked)
    auto voc_ports = findPorts("InstrumentVocoder", false);
    auto voc_in = findPorts("InstrumentVocoder", true);
    if (processAlive(voc_pid_) && voc_ports.empty() && voc_in.empty()) {
        // Host alive but ports not visible yet -- small wait then recheck once
        // (caller runs every 2s so next tick will catch it; still flag rebuild)
        need_rebuild = true;
    }
    // Mic: ALSA sees it but PipeWire may not have exported capture yet.
    // Activate profile in-process (no GUI). Do NOT force a full graph
    // rebuild just for this in Mode 1 -- that was causing periodic xruns.
    if (mic.present && mic.capture_ports.empty()) {
        Logger::warning("Health: mic present in ALSA but no PW capture ports yet");
        if (activateMicCapturePorts()) {
            mic = queryMic();
            // Ports just appeared: rebuild so Mode 2/3/5 can link them.
            if (mode_ == PerformanceMode::VocoderOnly
                || mode_ == PerformanceMode::SynthAndVocoder
                || mode_ == PerformanceMode::BreathOctaveMic) {
                need_rebuild = true;
            }
        }
    }

    // ------------------------------------------------------------------
    // 4) Rebuild current mode wiring only when something actually
    // changed or died (dead process, missing ports). No blind rebuild
    // on a timer: a rebuild tears down and relinks every owned
    // connection (see forceDisconnectInstrumentGraph()) and produces
    // an audible JACK xrun every time it fires, so it must only run
    // when need_rebuild says something real is actually wrong.
    // ------------------------------------------------------------------
    PerformanceMode m = mode_;
    if (need_rebuild) {
        Logger::debug(
            std::string("Health: ensureHealthyGraph mode=")
            + std::to_string(static_cast<int>(m))
            + " rebuild=yes");
        setMode(m);
        applyMixerLevels(last_master_, last_dry_, last_vocoder_, last_drums_,
                          last_synth_, last_mic_);
    }
}




// ===== Differential mode graph (modediff) ================================
std::vector<AudioGraphManager::LinkRole>
AudioGraphManager::desiredRoles(PerformanceMode mode)
{
    using R = LinkRole;
    switch (mode) {
    case PerformanceMode::SynthOnly:
    case PerformanceMode::BreathOctave:
        return {R::MelSl, R::MelHp, R::DrumSl, R::DrumHp, R::SlHp,
                R::MidiMel, R::MidiDru};
    case PerformanceMode::VocoderOnly:
        return {R::MelVoc, R::MicSide, R::VocSl, R::VocHp,
                R::DrumSl, R::DrumHp, R::SlHp, R::MidiMel, R::MidiDru};
    case PerformanceMode::SynthAndVocoder:
        return {R::MelVoc, R::MicSide, R::VocSl, R::VocHp,
                R::MicSl, R::MicHp,
                R::DrumSl, R::DrumHp, R::SlHp, R::MidiMel, R::MidiDru};
    case PerformanceMode::BreathOctaveMic:
        return {R::MelSl, R::MelHp, R::DrumSl, R::DrumHp, R::SlHp,
                R::MicSl, R::MicHp, R::MidiMel, R::MidiDru};
    case PerformanceMode::Talkbox:
        return {R::MelMvx, R::MicSl, R::MicHp,
                R::DrumSl, R::DrumHp, R::SlHp, R::MidiMel, R::MidiDru};
    }
    return {R::MelSl, R::MelHp, R::DrumSl, R::DrumHp, R::SlHp,
            R::MidiMel, R::MidiDru};
}

std::vector<std::pair<std::string,std::string>>
AudioGraphManager::resolveRole(LinkRole role)
{
    std::vector<std::pair<std::string,std::string>> out;

    auto mel_l = resolveClientPort(cfg_.zyn_client_name, "out_1", false);
    auto mel_r = resolveClientPort(cfg_.zyn_client_name, "out_2", false);
    auto dr_l  = resolveClientPort(cfg_.zyn_drums_client_name, "out_1", false);
    auto dr_r  = resolveClientPort(cfg_.zyn_drums_client_name, "out_2", false);
    if (mel_l.empty()) mel_l = "zynaddsubfx_zyn-melody:out_1";
    if (mel_r.empty()) mel_r = "zynaddsubfx_zyn-melody:out_2";
    if (dr_l.empty())  dr_l  = "zynaddsubfx_zyn-drums:out_1";
    if (dr_r.empty())  dr_r  = "zynaddsubfx_zyn-drums:out_2";

    std::string sl_in_l, sl_in_r, sl_out_l, sl_out_r;
    if (!resolveLooperPorts(sl_in_l, sl_in_r, sl_out_l, sl_out_r)) {
        sl_in_l = "sooperlooper:common_in_1";
        sl_in_r = "sooperlooper:common_in_2";
        sl_out_l = "sooperlooper:common_out_1";
        sl_out_r = "sooperlooper:common_out_2";
    }

    std::string play_l = defaultPlaybackPort(true);
    std::string play_r = defaultPlaybackPort(false);
    if (play_l.empty() || play_l.find("MVX2U") != std::string::npos)
        play_l = PI_AUDIO_LEFT_SINK;
    if (play_r.empty() || play_r.find("MVX2U") != std::string::npos)
        play_r = PI_AUDIO_RIGHT_SINK;

    const std::string vin_l = "InstrumentVocoder:in_l";
    const std::string vin_r = "InstrumentVocoder:in_r";
    const std::string vside = "InstrumentVocoder:sidechain";
    const std::string vside2 = "InstrumentVocoder:sidechain2";
    const std::string vout_l = "InstrumentVocoder:out_l";
    const std::string vout_r = "InstrumentVocoder:out_r";

    MicInfo mic = queryMic();
    std::string mvx_l, mvx_r;
    (void)resolveMvx2uPlaybackPorts(mvx_l, mvx_r);

    auto add2 = [&](const std::string& a, const std::string& b,
                    const std::string& c, const std::string& d) {
        if (!a.empty() && !c.empty()) out.emplace_back(a, c);
        if (!b.empty() && !d.empty()) out.emplace_back(b, d);
    };

    switch (role) {
    case LinkRole::MelSl:  add2(mel_l, mel_r, sl_in_l, sl_in_r); break;
    case LinkRole::MelHp:  add2(mel_l, mel_r, play_l, play_r); break;
    case LinkRole::MelVoc: add2(mel_l, mel_r, vin_l, vin_r); break;
    case LinkRole::MelMvx:
        if (!mvx_l.empty() && !mvx_r.empty())
            add2(mel_l, mel_r, mvx_l, mvx_r);
        break;
    case LinkRole::DrumSl:
        if (processAlive(zyn_drums_pid_))
            add2(dr_l, dr_r, sl_in_l, sl_in_r);
        break;
    case LinkRole::DrumHp:
        if (processAlive(zyn_drums_pid_))
            add2(dr_l, dr_r, play_l, play_r);
        break;
    case LinkRole::VocSl:  add2(vout_l, vout_r, sl_in_l, sl_in_r); break;
    case LinkRole::VocHp:  add2(vout_l, vout_r, play_l, play_r); break;
    case LinkRole::MicSide:
        for (const auto& p : mic.capture_ports) {
            if (!p.empty()) {
                out.emplace_back(p, vside);
                out.emplace_back(p, vside2);
            }
        }
        break;
    case LinkRole::MicSl:
        for (const auto& p : mic.capture_ports) {
            if (!p.empty()) {
                out.emplace_back(p, sl_in_l);
                out.emplace_back(p, sl_in_r);
            }
        }
        break;
    case LinkRole::MicHp:
        for (const auto& p : mic.capture_ports) {
            if (!p.empty()) {
                out.emplace_back(p, play_l);
                out.emplace_back(p, play_r);
            }
        }
        break;
    case LinkRole::SlHp:
        add2(sl_out_l, sl_out_r, play_l, play_r);
        break;
    case LinkRole::MidiMel: {
        std::string midi = findEngineMidiPort();
        std::string dst = resolveClientPort(cfg_.zyn_client_name, "midi_input", true);
        if (!midi.empty() && !dst.empty())
            out.emplace_back(midi, dst);
        break;
    }
    case LinkRole::MidiDru: {
        std::string midi = findEngineDrumsMidiPort();
        std::string dst = resolveClientPort(cfg_.zyn_drums_client_name, "midi_input", true);
        if (!midi.empty() && !dst.empty() && processAlive(zyn_drums_pid_))
            out.emplace_back(midi, dst);
        break;
    }
    }
    return out;
}


// ===== modespeed: port cache + pre-computed link sets =====================
void AudioGraphManager::invalidatePortCache()
{
    port_cache_.valid = false;
    for (auto& v : mode_link_cache_valid_) v = false;
}

void AudioGraphManager::refreshPortCache()
{
    PortCache& c = port_cache_;
    c = PortCache{};                         // zero

    c.mel_l = resolveClientPort(cfg_.zyn_client_name, "out_1", false);
    c.mel_r = resolveClientPort(cfg_.zyn_client_name, "out_2", false);
    c.dr_l  = resolveClientPort(cfg_.zyn_drums_client_name, "out_1", false);
    c.dr_r  = resolveClientPort(cfg_.zyn_drums_client_name, "out_2", false);
    if (c.mel_l.empty()) c.mel_l = "zynaddsubfx_zyn-melody:out_1";
    if (c.mel_r.empty()) c.mel_r = "zynaddsubfx_zyn-melody:out_2";
    if (c.dr_l.empty())  c.dr_l  = "zynaddsubfx_zyn-drums:out_1";
    if (c.dr_r.empty())  c.dr_r  = "zynaddsubfx_zyn-drums:out_2";

    if (!resolveLooperPorts(c.sl_in_l, c.sl_in_r, c.sl_out_l, c.sl_out_r)) {
        c.sl_in_l  = "sooperlooper:common_in_1";
        c.sl_in_r  = "sooperlooper:common_in_2";
        c.sl_out_l = "sooperlooper:common_out_1";
        c.sl_out_r = "sooperlooper:common_out_2";
    }

    c.play_l = defaultPlaybackPort(true);
    c.play_r = defaultPlaybackPort(false);
    if (c.play_l.empty() || c.play_l.find("MVX2U") != std::string::npos)
        c.play_l = PI_AUDIO_LEFT_SINK;
    if (c.play_r.empty() || c.play_r.find("MVX2U") != std::string::npos)
        c.play_r = PI_AUDIO_RIGHT_SINK;

    c.vin_l  = "InstrumentVocoder:in_l";
    c.vin_r  = "InstrumentVocoder:in_r";
    c.vside  = "InstrumentVocoder:sidechain";
    c.vside2 = "InstrumentVocoder:sidechain2";
    c.vout_l = "InstrumentVocoder:out_l";
    c.vout_r = "InstrumentVocoder:out_r";

    MicInfo mic = queryMic();
    c.mic_capture = mic.capture_ports;
    (void)resolveMvx2uPlaybackPorts(c.mvx_l, c.mvx_r);   // may log once

    c.midi_mel = findEngineMidiPort();
    c.midi_dru = findEngineDrumsMidiPort();

    c.valid = true;
    // Logger::info("modespeed: port cache refreshed");
}

const AudioGraphManager::PortCache& AudioGraphManager::portCache()
{
    if (!port_cache_.valid)
        refreshPortCache();
    return port_cache_;
}

std::vector<std::pair<std::string,std::string>>
AudioGraphManager::cachedLinksFor(PerformanceMode mode)
{
    const int idx = static_cast<int>(mode);
    if (idx < 0 || idx >= 6) return {};
    if (!mode_link_cache_valid_[idx])
        ensureModeLinksCached(mode);
    return mode_link_cache_[idx];
}

void AudioGraphManager::ensureModeLinksCached(PerformanceMode mode)
{
    // Build the concrete list exactly once (or after invalidate).
    const int idx = static_cast<int>(mode);
    if (idx < 0 || idx >= 6) return;
    if (mode_link_cache_valid_[idx]) return;

    // Make sure processes that this mode needs are alive (cheap if already up).
    if (!processAlive(zyn_pid_))       launchZyn();
    if (!processAlive(zyn_drums_pid_)) launchZynDrums();
    if (!processAlive(sl_pid_))        launchSooperLooper();
    if (mode == PerformanceMode::VocoderOnly ||
        mode == PerformanceMode::SynthAndVocoder) {
        if (!processAlive(voc_pid_)) launchVocoder();
    }
    if (mode == PerformanceMode::BreathOctaveMic ||
        mode == PerformanceMode::Talkbox ||
        mode == PerformanceMode::SynthAndVocoder) {
        ensureMvx2uMicCaptureLive();
    }
    if (mode == PerformanceMode::Talkbox)
        forceMvx2uPurePlayback();

    // Force a fresh resolution so the cache is accurate for this mode.
    refreshPortCache();
    const PortCache& c = port_cache_;

    std::vector<std::pair<std::string,std::string>> want;
    auto add2 = [&](const std::string& a, const std::string& b,
                    const std::string& d, const std::string& e) {
        if (!a.empty() && !d.empty()) want.emplace_back(a, d);
        if (!b.empty() && !e.empty()) want.emplace_back(b, e);
    };

    auto roles = desiredRoles(mode);
    for (auto r : roles) {
        switch (r) {
        case LinkRole::MelSl:  add2(c.mel_l, c.mel_r, c.sl_in_l, c.sl_in_r); break;
        case LinkRole::MelHp:  add2(c.mel_l, c.mel_r, c.play_l,  c.play_r);  break;
        case LinkRole::MelVoc: add2(c.mel_l, c.mel_r, c.vin_l,   c.vin_r);   break;
        case LinkRole::MelMvx:
            if (!c.mvx_l.empty() && !c.mvx_r.empty())
                add2(c.mel_l, c.mel_r, c.mvx_l, c.mvx_r);
            break;
        case LinkRole::DrumSl:
            if (processAlive(zyn_drums_pid_))
                add2(c.dr_l, c.dr_r, c.sl_in_l, c.sl_in_r);
            break;
        case LinkRole::DrumHp:
            if (processAlive(zyn_drums_pid_))
                add2(c.dr_l, c.dr_r, c.play_l, c.play_r);
            break;
        case LinkRole::VocSl:  add2(c.vout_l, c.vout_r, c.sl_in_l, c.sl_in_r); break;
        case LinkRole::VocHp:  add2(c.vout_l, c.vout_r, c.play_l,  c.play_r);  break;
        case LinkRole::MicSide:
            for (const auto& p : c.mic_capture) {
                if (!p.empty()) {
                    want.emplace_back(p, c.vside);
                    want.emplace_back(p, c.vside2);
                    break;
                }
            }
            break;
        case LinkRole::MicSl:
            for (const auto& p : c.mic_capture) {
                if (!p.empty()) {
                    want.emplace_back(p, c.sl_in_l);
                    want.emplace_back(p, c.sl_in_r);
                    break;
                }
            }
            break;
        case LinkRole::MicHp:
            for (const auto& p : c.mic_capture) {
                if (!p.empty()) {
                    want.emplace_back(p, c.play_l);
                    want.emplace_back(p, c.play_r);
                    break;
                }
            }
            break;
        case LinkRole::SlHp:
            add2(c.sl_out_l, c.sl_out_r, c.play_l, c.play_r);
            break;
        case LinkRole::MidiMel: {
            std::string dst = resolveClientPort(cfg_.zyn_client_name, "midi_input", true);
            if (!c.midi_mel.empty() && !dst.empty())
                want.emplace_back(c.midi_mel, dst);
            break;
        }
        case LinkRole::MidiDru: {
            std::string dst = resolveClientPort(cfg_.zyn_drums_client_name, "midi_input", true);
            if (!c.midi_dru.empty() && !dst.empty() && processAlive(zyn_drums_pid_))
                want.emplace_back(c.midi_dru, dst);
            break;
        }
        }
    }

    mode_link_cache_[idx] = std::move(want);
    mode_link_cache_valid_[idx] = true;
    // Logger::info("modespeed: cached " + std::to_string(mode_link_cache_[idx].size())
    //              + " links for mode " + std::to_string(idx));
}

// Fast path used by applyModeTransition: only the delta.
bool AudioGraphManager::ensureModeLinks(PerformanceMode mode)
{
    ensureModeLinksCached(mode);                 // no-op if already cached
    const auto& want = mode_link_cache_[static_cast<int>(mode)];

    // Build the universe once from the cache of *all* roles so we can
    // sever anything that should not be present.
    static const LinkRole kAll[] = {
        LinkRole::MelSl, LinkRole::MelHp, LinkRole::MelVoc, LinkRole::MelMvx,
        LinkRole::DrumSl, LinkRole::DrumHp,
        LinkRole::VocSl, LinkRole::VocHp,
        LinkRole::MicSide, LinkRole::MicSl, LinkRole::MicHp,
        LinkRole::SlHp, LinkRole::MidiMel, LinkRole::MidiDru
    };
    // We still need a universe, but we can build it cheaply from the
    // six cached mode sets (union).  First time we ever run we may have
    // only one mode cached; fall back to a full resolveRole pass only then.
    std::vector<std::pair<std::string,std::string>> universe;
    bool any = false;
    for (int i = 0; i < 6; ++i) {
        if (mode_link_cache_valid_[i]) {
            any = true;
            universe.insert(universe.end(),
                            mode_link_cache_[i].begin(),
                            mode_link_cache_[i].end());
        }
    }
    if (!any) {
        // cold start – resolve the hard way once
        for (auto r : kAll) {
            auto pairs = resolveRole(r);
            universe.insert(universe.end(), pairs.begin(), pairs.end());
        }
    }

    auto is_wanted = [&](const std::string& s, const std::string& d) {
        for (const auto& w : want)
            if (w.first == s && w.second == d) return true;
        return false;
    };

    // Sever only what is not wanted (quiet – no spam on "not linked")
    for (const auto& u : universe) {
        if (!is_wanted(u.first, u.second))
            pwUnlink(u.first, u.second);
    }
    // Create only what is missing (pw-link "File exists" is now silent)
    for (const auto& w : want)
        pwLink(w.first, w.second);

    // Logger::info("ensureModeLinks: mode graph applied (" +
    //              std::to_string(want.size()) + " target pairs) [cached]");
    return true;
}

bool AudioGraphManager::applyModeTransition(PerformanceMode from,
                                            PerformanceMode to)
{
    // Logger::info("Mode transition " + std::to_string(static_cast<int>(from))
    //              + " -> " + std::to_string(static_cast<int>(to)));

    // Make sure both ends are cached (first time each mode is seen).
    ensureModeLinksCached(from);
    ensureModeLinksCached(to);

    if (from == to) {
        // Same-mode press: just verify the links are still there (cheap).
        const auto& want = mode_link_cache_[static_cast<int>(to)];
        for (const auto& w : want)
            pwLink(w.first, w.second);   // silent if already present
        return true;
    }

    const bool entering_tb = (to == PerformanceMode::Talkbox);
    const bool leaving_tb  = (from == PerformanceMode::Talkbox && !entering_tb);

    if (entering_tb) {
        forceMvx2uPurePlayback();
        const std::string& tb = cfg_.zyn_talkbox_instrument.empty()
            ? std::string("config/talkbox.xmz")
            : cfg_.zyn_talkbox_instrument;
        reloadMelodyInstrument(tb);
        invalidatePortCache();           // instrument change may move ports
    } else if (leaving_tb) {
        std::string path = cfg_.zyn_normal_instrument.empty()
            ? std::string("config/mkb.xmz")
            : cfg_.zyn_normal_instrument;
        if (path.find("talkbox") != std::string::npos)
            path = "config/mkb.xmz";
        reloadMelodyInstrument(path);
        invalidatePortCache();
    }

    // Pure set-difference using the two cached vectors.
    const auto& from_links = mode_link_cache_[static_cast<int>(from)];
    const auto& to_links   = mode_link_cache_[static_cast<int>(to)];

    auto in_list = [](const std::vector<std::pair<std::string,std::string>>& L,
                      const std::string& s, const std::string& d) {
        for (const auto& p : L)
            if (p.first == s && p.second == d) return true;
        return false;
    };

    // Unlink everything that is in from but not in to
    for (const auto& p : from_links) {
        if (!in_list(to_links, p.first, p.second))
            pwUnlink(p.first, p.second);
    }
    // Link everything that is in to but not in from
    for (const auto& p : to_links) {
        if (!in_list(from_links, p.first, p.second))
            pwLink(p.first, p.second);
    }

    mode_ = to;
    return true;
}

bool AudioGraphManager::setMode(PerformanceMode mode) {
    const PerformanceMode from = mode_;
    const bool ok = applyModeTransition(from, mode);
    mode_ = mode;                       // already set inside apply, but keep consistent
    switch (mode) {
    case PerformanceMode::SynthOnly:
        Logger::info("Mode SynthOnly (Mode 1) [fast]");
        break;
    case PerformanceMode::VocoderOnly:
        Logger::info("Mode VocoderOnly (Mode 2) [fast]");
        break;
    case PerformanceMode::SynthAndVocoder:
        Logger::info("Mode SynthAndVocoder (Mode 3) [fast]");
        break;
    case PerformanceMode::BreathOctave:
        Logger::info("Mode BreathOctave (Mode 4) [fast]");
        break;
    case PerformanceMode::BreathOctaveMic:
        Logger::info("Mode BreathOctaveMic (Mode 5) [fast]");
        break;
    case PerformanceMode::Talkbox:
        Logger::info("Mode Talkbox (Mode 6) [fast]");
        break;
    }
    return ok;
}
